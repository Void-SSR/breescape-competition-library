otions_bottom_divider","multi_product_addon_group","logistic","creator_video","creator_video_bottom_divider","seller_above_review","shop_recommend_above_review","shop_recommend_above_review_bottom_divider","review","review_bottom_divider","questions","questions_bottom_divider","description_title","about_this_product_description","about_this_product_size_guide_top_line","about_this_product_size_guide","about_this_product_details_top_line","about_this_product_details","about_this_product_compliance_top_line","about_this_product_compliance","about_this_product_compliance_bottom_divider"]},"aigc_info":{"long_text":"Shilucheng Bamboo Sheet Set is designed for everyday comfort with a soft, smooth feel and a practical deep-pocket fit. Made from 60% rayon derived from bamboo and 40% polyester fiber, it combines a silky touch with durability and easy care. The twill weave adds to the smooth texture, while the lightweight feel makes it suitable for warm-weather sleeping.\n\nThis bedding set is a good choice for hot sleepers and anyone who wants a cooler, more breathable sleep surface. The fitted sheet has strong elasticity and is designed to fit mattresses up to 16 inches thick, helping it stay in place through the night. It is also made to absorb moisture and help regulate heat for a drier sleeping experience.\n\nAvailable in multiple bedding sizes and color options, the set includes 4-piece and 6-piece versions with flat sheet, fitted sheet, and pillowcases. It is machine washable for simple care and everyday use.","faq":"Q:What materials are used in this sheet set?\nA:It is made from 60% rayon derived from bamboo and 40% polyester fiber.\n\nQ:How deep is the fitted sheet pocket?\nA:The fitted sheet is designed to fit mattresses up to 16 inches thick.\n\nQ:What type of weave does the sheet set use?\nA:It uses a twill weave.\n\nQ:Is this sheet set suitable for warm weather?\nA:Yes. The product is described as cooling, breathable, and suitable for summer use.\n\nQ:What items are included in the set?\nA:The 4-piece and 6-piece sets include 1 flat sheet, 1 fitted sheet, and 2 or 4 pillowcases.\n\nQ:How should this sheet set be cared for?\nA:It is machine washable. The care instructions say to wash in cold water on a gentle cycle and dry at low temperatures.","bullet_points":"• Made with 60% rayon derived from bamboo and 40% polyester fiber\n• Deep pocket fitted sheet stretches to fit mattresses up to 16 inches thick\n• Twill weave creates a smooth, silky-soft feel\n• Cooling and breathable design helps absorb moisture and heat\n• Machine washable and easy to care for","aigc_title":"Shilucheng Bamboo Sheet Set, 16\" Deep Pocket","aigc_description":"Shilucheng Bamboo Sheet Set features a 16\" deep pocket fit, soft twill weave, and breathable moisture control for cool, comfortable sleep.","aigc_keywords":[{"keyword":"Shilucheng Bamboo Sheet Set"},{"keyword":"bamboo sheets"},{"keyword":"16 deep pocket sheets"},{"keyword":"cooling breathable bedding"},{"keyword":"soft twill fitted sheets"},{"keyword":"queen bamboo sheet set"},{"keyword":"wrinkle resistant sheets"},{"keyword":"fade resistant bedding"}]},"review_info":{"has_more":true,"total_reviews":"46195","product_reviews":[{"review_id":"7675877465685444366","product_id":"1729438233542234865","sku_id":"1729438239846011633","reviewer_id":"6776811819815191558","review_rating":1,"review_time":"1787179496439","is_verified_purchase":true,"is_incentivized_review":false,"product_name":"Shilucheng Bamboo Sheet Set - 4\u002F6 Pc Bedding Set with 16'' Deep Pocket Lightweight, Twill, Smooth Fitted Sheets, Cooling Breathable, Hotel Luxury Super Silky Soft, Wrinkle & Fade Resistant","reviewer_name":"C**💝","reviewer_avatar_url":"https:\u002F\u002Fp19-common-sign.tiktokcdn-us.com\u002Ftos-useast5-avt-0068-tx\u002F26665bd4051f509ae014203ba8d326ed~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=e849b0e8&x-expires=1794034800&x-signature=p6dtuoBY6G6b4BIzn1a0aMjkc3k%3D&t=4d5b0474&ps=13740610&shp=a5d48078&shcp=5f8d3399&idc=useast5","review_text":"I did not get what I ordered in my order list it says order delivered and here are the pictures of what came in the box I demand a refund or please resend the item or I’m going to expose you guys. Thank you.","display_image_url":"https:\u002F\u002Fp16-oec-general-useast5.ttcdn-us.com\u002Ftos-useast5-i-omjb5zjo8w-tx\u002F3c3e526665754bffbf67f5bfeb279a0f~tplv-fhlh96nyum-crop-webp:300:300.webp?dr=12190&t=555f072d&ps=933b5bde&shp=8dbd94bf&shcp=607f11de&idc=useast5&from=2378011839","review_images":["https:\u002F\u002Fp16-oec-general-useast5.ttcdn-us.com\u002Ftos-useast5-i-omjb5zjo8w-tx\u002F3c3e526665754bffbf67f5bfeb279a0f~tplv-fhlh96nyum-crop-webp:300:300.webp?dr=12190&t=555f072d&ps=933b5bde&shp=8dbd94bf&shcp=607f11de&idc=useast5&from=2378011839","https:\u002F\u002Fp16-oec-general-useast5.ttcdn-us.com\u002Ftos-useast5-i-omjb5zjo8w-tx\u002F2da0e97bf92c4f4aa5e85e4c1dc5a145~tplv-fhlh96nyum-crop-webp:300:300.webp?dr=12190&t=555f072d&ps=933b5bde&shp=8dbd94bf&shcp=607f11de&idc=useast5&from=2378011839","https:\u002F\u002Fp16-oec-general-useast5.ttcdn-us.com\u002Ftos-useast5-i-omjb5zjo8w-tx\u002F24d309825f3249009972fb94e3b817b0~tplv-fhlh96nyum-crop-webp:300:300.webp?dr=12190&t=555f072d&ps=933b5bde&shp=8dbd94bf&shcp=607f11de&idc=useast5&from=2378011839","https:\u002F\u002Fp16-oec-general-useast5.ttcdn-us.com\u002Ftos-useast5-i-omjb5zjo8w-tx\u002Faa0799b6d51f41e091bfdbc2494ef860~tplv-fhlh96nyum-crop-webp:300:300.webp?dr=12190&t=555f072d&ps=933b5bde&shp=8dbd94bf&shcp=607f11de&idc=useast5&from=2378011839","https:\u002F\u002Fp16-oec-general-useast5.ttcdn-us.com\u002Ftos-useast5-i-omjb5zjo8w-tx\u002Ff552271750b84aca9126628612c405e4~tplv-fhlh96nyum-crop-webp:300:300.webp?dr=12190&t=555f072d&ps=933b5bde&shp=8dbd94bf&shcp=607f11de&idc=useast5&from=2378011839"],"sku_specification":"Bamboo-Burgundy, King, 4PC","review_country":"US"},{"review_id":"7658340034542569230","product_id":"1729438233542234865","sku_id":"1729438098642146033","reviewer_id":"7639506845387899918","review_rating":2,"review_time":"1783708186593","is_verified_purchase":true,"is_incentivized_review":false,"product_name":"Shilucheng Bamboo Sheet Set - 4\u002F6 Pc Bedding Set with 16'' Deep Pocket Lightweight, Twill, Smooth Fitted Sheets, Cooling Breathable, Hotel Luxury Super Silky Soft, Wrinkle & Fade Resistant","reviewer_name":"N**d","reviewer_avatar_url":"https:\u002F\u002Fp16-common-sign.tiktokcdn-us.com\u002Ftos-useast8-avt-0068-tx2\u002Fa40d6d46818dfbc6b4a80a7ddd59a277~tplv-tiktokx-cropcenter:100:100.jpg?dr=9640&refresh_token=5b99e030&x-expires=1794034800&x-signature=qj%2FzUEWmG%2FUajfZmtmEYuHIoNyI%3D&t=4d5b0474&ps=13740610&shp=a5d48078&shcp=5f8d3399&idc=useast5","review_text":"Price was great. Fits great with deep pockets. Unfortunately the craftsmanship has some to be desired. Stitching is unraveling all over on sheets and pillow cases. Color variation from picture to actual product. If you’re looking for cheap product this is for you. If you’re looking for something durable and long lasting this was coming apart before the first wash and wear. I’m a bit disappointed.","display_image_url":"https:\u002F\u002Fp16-oec-general-useast5.ttcdn-us.com\u002Ftos-useast5-i-omjb5zjo8w-tx\u002F4349d16a122242aea67f114ea345a3a7~tplv-fhlh96nyum-crop-webp:300:300.webp?dr=12190&t=555f072d&ps=933b5bde&shp=8dbd94bf&shcp=607f11de&idc=useast5&from=2378011839","review_images":["https:\u002F\u002Fp19-oec-general-useast5.ttcdn-us.com\u002Ftos-useast5-i-omjb5zjo8w-tx\u002F4349d16a122242aea67f114ea345a3a7~tplv-fhlh96nyum-crop-webp:300:300.webp?dr=12190&t=555f072d&ps=933b5bde&shp=8dbd94bf&shcp=607f11de&idc=useast5&from=2378011839","https:\u002F\u002Fp16-oec-general-useast5.ttcdn-us.com\u002Ftos-useast5-i-omjb5zjo8w-tx\u002Feb6bf27076f04446818ebae23c70e256~tplv-fhlh96nyum-crop-webp:300:300.webp?dr=12190&t=555f072d&ps=933b5bde&shp=8dbd94bf&shcp=607f11de&idc=useast5&from=2378011839","https:\u002F\u002Fp16-oec-general-useast5.ttcdn-us.com\u002Ftos-useast5-i-omjb