  el.appendChild(document.createTextNode("\u200B"));

  function mountRoot() {
    if (!document.body) return;

    document.body.appendChild(el);
    document.removeEventListener("readystatechange", mountRoot);
  }

  if (document.body) {
    mountRoot();
  } else {
    document.addEventListener("readystatechange", mountRoot);
  }
})();
</script>


