<script>
  // Prevent duplicate initialization if both app embeds are enabled
  if (window.kachingBundlesAppEmbedLoaded) {
    console.warn('[Kaching Bundles] Multiple app embed blocks detected. Please disable one of them. Skipping duplicate initialization.');
  } else {
    window.kachingBundlesAppEmbedLoaded = true;
    window.kachingBundlesEnabled = true;
    window.kachingBundlesInitialized = false;

    // Allow calling kachingBundlesInitialize before the script is loaded
    (() => {
      let shouldInitialize = false;
      let realInitialize = null;

      window.kachingBundlesInitialize = () => {
        if (realInitialize) {
          realInitialize();
        } else {
          shouldInitialize = true;
        }
      };

      Object.defineProperty(window, '__kachingBundlesInitializeInternal', {
        set(fn) {
          realInitialize = fn;
          if (shouldInitialize) {
            shouldInitialize = false;
            fn();
          }
        },
        get() {
          return realInitialize;
        }
      });
    })();
  }
</script>


  <script>
    // Wraps window.fetch at HTML parse time, before any external script runs,
    // so third-party scripts that capture their own window.fetch reference get
    // one with our hook inside. Pure passthrough until the widget assigns the
    // real handler (CartInterceptor#start); stays a passthrough forever if the
    // widget never loads. The cart trace (startCartTrace) can add an observer
    // below the handler, so it sees the requests the handler actually sends.
    (() => {
      try {
        if (window.__kachingBundlesFetchHandler !== undefined) return;

        const originalFetch = window.fetch.bind(window);
        window.__kachingBundlesRawFetch = originalFetch;
        window.__kachingBundlesFetchHandler = null;
        window.fetch = (input, init) => {
          const handler = window.__kachingBundlesFetchHandler;
          const observer = window.__kachingBundlesFetchObserver;
          const networkFetch = observer
            ? (input, init) => observer(originalFetch, input, init)
            : originalFetch;
          return handler ? handler(networkFetch, input, init) : networkFetch(input, init);
        };
      } catch (error) {
        console.error(error);
      }
    })();
  </script>


