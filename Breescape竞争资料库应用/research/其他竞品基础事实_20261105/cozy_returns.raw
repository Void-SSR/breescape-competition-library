875408118","__v":0,"imageAlt":""}});

    if (!items.length) return;

    const hasCountryCondition = items.some(({ status, settings }) =>
      status === 'published' &&
      settings?.displayCondition?.variants?.some(c => c.id === 'visitorCountry')
    );

    if (!hasCountryCondition) return;const COUNTRY_CACHE_TTL_MS = 300000; // @COUNTRY_CACHE_TTL_MS
    const COUNTRY_KEY = 'country';
    const COUNTRY_EXPIRES_KEY = 'country_expires';

    try {
      const cached = sessionStorage.getItem(COUNTRY_KEY);
      const expiresAt = Number(sessionStorage.getItem(COUNTRY_EXPIRES_KEY));
      if (cached && expiresAt && Date.now() < expiresAt) return;
    } catch (e) {}

    try {
      const res = await fetch(`${window?.Shopify?.routes?.root || '/'}browsing_context_suggestions.json?source=geolocation_recommendation&country[enabled]=true`);
      const json = await res.json();
      const country = json?.detected_values?.country?.handle;
      if (country) {
        sessionStorage.setItem(COUNTRY_KEY, country);
        sessionStorage.setItem(COUNTRY_EXPIRES_KEY, String(Date.now() + COUNTRY_CACHE_TTL_MS));
      }
    } catch (e) {
      console.error('Geolocation fetch failed:', e);
    }
  })()
</script>
