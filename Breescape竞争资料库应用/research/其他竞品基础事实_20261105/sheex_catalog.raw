],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Arctic-SheetSets-MorningIvory-2.jpg?v=1784572103","width":750,"height":750},{"id":41311177375882,"created_at":"2026-06-04T17:02:08-04:00","position":3,"updated_at":"2026-07-20T14:28:20-04:00","product_id":8543208538250,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Arctic-SheetSets-MorningIvory-3.jpg?v=1784572100","width":750,"height":750},{"id":41311177244810,"created_at":"2026-06-04T17:02:08-04:00","position":4,"updated_at":"2026-07-20T14:28:09-04:00","product_id":8543208538250,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Arctic-SheetSets-MorningIvory-4.jpg?v=1784572089","width":750,"height":750}],"options":[{"name":"Choose Your Color","position":1,"values":["Morning Ivory"]},{"name":"Choose Your Size","position":2,"values":["King","California King","Queen"]}]},{"id":8188221718666,"title":"Women's Cutout Tee - Light Blue - Outlet","handle":"womens-cutout-tee","body_html":"\u003cdiv class=\"ootb-tabcordion\"\u003e\n\u003cdiv aria-label=\"TabCordion\" role=\"tablist\" class=\"ootb-tabcordion--tabs\"\u003e\n\u003cbutton id=\"tab1\" aria-controls=\"tab1-tab\" aria-selected=\"true\" role=\"tab\" class=\"tab is-active\"\u003eDescription\u003c\/button\u003e \u003cbutton id=\"tab2\" aria-controls=\"tab2-tab\" aria-selected=\"false\" role=\"tab\" class=\"tab\" tabindex=\"-1\"\u003eDetails\u003c\/button\u003e \u003cbutton id=\"tab3\" aria-controls=\"tab3-tab\" aria-selected=\"false\" role=\"tab\" class=\"tab\" tabindex=\"-1\"\u003eCare\u003c\/button\u003e \u003cbutton id=\"tab4\" aria-controls=\"tab4-tab\" aria-selected=\"false\" role=\"tab\" class=\"tab\" tabindex=\"-1\"\u003eSize Guide\u003c\/button\u003e\n\u003c\/div\u003e\n\u003csection aria-labelledby=\"tab1\" role=\"tabpanel\" data-title=\"Description\" class=\"ootb-tabcordion--entry is-active\" id=\"tab1-tab\" tabindex=\"0\"\u003e\n\u003cdiv class=\"ootb-tabcordion--entry-container\"\u003e\n\u003cdiv class=\"ootb-tabcordion--entry-content\"\u003e\n\u003cp\u003e\u003cstrong\u003e*This product is FINAL SALE and non-returnable.\u003c\/strong\u003e\u003cbr\u003e\u003cbr\u003eOur sleepwear is made from the same ridiculously soft SHEEX® performance fabrics as our sheets, providing unparalleled breathability and moisture wicking to maintain your body at its ideal sleep temperature while resisting odors.\u003cbr\u003e\u003cbr\u003eOur cutout tee marries a classic silhouette with a modern aesthetic and ultimate comfort. This is truly the perfect tee for lounging or sleeping. |\u003cem\u003e made to move with you from 8 pm to 8 am\u003c\/em\u003e\u003cem\u003e.\u003c\/em\u003e\u003c\/p\u003e\n\u003csection id=\"tab1-tab\" class=\"ootb-tabcordion--entry is-active\" data-title=\"Description\" role=\"tabpanel\" aria-labelledby=\"tab1\" tabindex=\"0\"\u003e\n\u003cdiv class=\"ootb-tabcordion--entry-container\"\u003e\n\u003cdiv class=\"ootb-tabcordion--entry-content\"\u003e\n\u003cp\u003e\u003cstrong\u003eFLEXIBLE. COMFORTABLE. EASY. MODERN. NON-RESTRICTIVE FIT.\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp\u003eLet SHEEX Own the Night®, so you can own your day.\u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eSHEEX®\u003cspan data-mce-fragment=\"1\"\u003e \u003c\/span\u003e\u003c\/strong\u003ePerformance Sleep | Comfort can not be compromised\u003c\/p\u003e\n\u003cp\u003e\u003cmeta charset=\"utf-8\"\u003e\u003cem data-mce-fragment=\"1\"\u003e*This product is FINAL SALE and non-returnable.\u003c\/em\u003e\u003cbr\u003e\u003cstrong\u003e\u003cbr\u003e\u003c\/strong\u003e\u003c\/p\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/section\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/section\u003e\n\u003csection aria-labelledby=\"tab2\" role=\"tabpanel\" data-title=\"Details\" class=\"ootb-tabcordion--entry\" id=\"tab2-tab\" tabindex=\"-1\"\u003e\n\u003cdiv class=\"ootb-tabcordion--entry-container\"\u003e\n\u003cdiv class=\"ootb-tabcordion--entry-content\"\u003e\n\u003cp\u003e\u003cstrong\u003eDETAILS\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eClassic tee shape, hi-low hem, cut-out back\u003c\/li\u003e\n\u003cli\u003eUltra- Soft against your skin.\u003c\/li\u003e\n\u003cli\u003eTemperature Regulation\u003c\/li\u003e\n\u003cli\u003eBreathable, lightweight 4-Way Stretch knit keeps you cool\u003c\/li\u003e\n\u003cli\u003eMoisture wicking [moisture wicking fabric pulls perspiration from the body]\u003c\/li\u003e\n\u003cli\u003eTagless Label [We use tagless labels for enhanced comfort]\u003c\/li\u003e\n\u003cli\u003eShape Retention [Innovative stretch material always keeps its shape]\u003c\/li\u003e\n\u003cli\u003eWrinkle Resistant\u003c\/li\u003e\n\u003cli\u003eSHEEX® Performance Fabric: 87% Polyester \/ 13% Spandex\u003c\/li\u003e\n\u003cli\u003eMachine Wash. Easy Care.\u003c\/li\u003e\n\u003cli\u003eImported\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003e\u003cstrong\u003eFIT\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp\u003eLoose, relaxed fit. Fits true to size.\u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eDESIGN DETAILS\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eSlightly scooped neckline\u003c\/li\u003e\n\u003cli\u003eSet-in sleeves\u003c\/li\u003e\n\u003cli\u003eCut-out back detail\u003c\/li\u003e\n\u003cli\u003eFlat lock stitching detail\u003c\/li\u003e\n\u003cli\u003eHi-low hem\u003c\/li\u003e\n\u003cli\u003eSHEEX® logo at front hem\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003e\u003cstrong\u003eSLEEP•FIT® technology\u003c\/strong\u003e - High-tech materials with integrated functional performance, focusing on \u003cstrong\u003e\u003cem\u003esensation \u003c\/em\u003e\u003c\/strong\u003eand the importance of \u003cstrong\u003e\u003cem\u003efeel, fit \u003c\/em\u003e\u003c\/strong\u003eand \u003cstrong\u003e\u003cem\u003ecomfort\u003c\/em\u003e\u003c\/strong\u003e during sleep.\u003c\/p\u003e\n\u003c\/div\u003e\n\