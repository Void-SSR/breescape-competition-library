opify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-Pillowcases-SandDune-2.jpg?v=1780612363","width":750,"height":750},{"id":41311438274698,"created_at":"2026-06-04T18:32:41-04:00","position":7,"updated_at":"2026-06-04T18:32:43-04:00","product_id":8709403934858,"variant_ids":[47224998101130,47224998133898],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-Pillowcases-BlackEclipse-1.jpg?v=1780612363","width":750,"height":750},{"id":41311438176394,"created_at":"2026-06-04T18:32:41-04:00","position":8,"updated_at":"2026-06-04T18:32:43-04:00","product_id":8709403934858,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-Pillowcases-BlackEclipse-2.jpg?v=1780612363","width":750,"height":750},{"id":42500373446794,"created_at":"2026-09-14T13:29:44-04:00","position":9,"updated_at":"2026-09-14T13:29:45-04:00","product_id":8709403934858,"variant_ids":[50196429242506,50196429275274],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-Pillowcases-BlueMist-1.jpg?v=1789406985","width":750,"height":750},{"id":42500373479562,"created_at":"2026-09-14T13:29:44-04:00","position":10,"updated_at":"2026-09-14T13:29:45-04:00","product_id":8709403934858,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-Pillowcases-BlueMist-2.jpg?v=1789406985","width":750,"height":750}],"options":[{"name":"Choose Your Color","position":1,"values":["Cloud White","Silver Dusk","Sand Dune","Black Eclipse","Blue Mist"]},{"name":"Choose Your Size","position":2,"values":["Standard","King"]}]},{"id":8709403902090,"title":"Nightfall Sheet Set","handle":"nightfall-sheet-set","body_html":"\u003cp\u003eMeet Nightfall™, the next evolution in performance bedding. Crafted from our advanced Cooling Nylon\/Spandex blend, this silky-smooth fabric delivers the ultimate in lightweight luxury. Naturally breathable and temperature-regulating, Nightfall keeps you cool, dry, and comfortable all night long. \u003c\/p\u003e\n\u003cp\u003eInspired by the calm of a tranquil lakeside retreat, Nightfall turns your bed into a sanctuary of serenity. Its whisper-light ultra-soft drape glides effortlessly across your skin, reducing friction to help minimize frizz, sleep lines, and dryness, so you wake refreshed and flawless. Each night, its cooling, effortlessly soft touch hugs your body in a cocoon of calm, creating a restful escape where tension fades and dreams take center stage. \u003c\/p\u003e\n\u003cp\u003eBuilt for warm sleepers and anyone who craves an airy, indulgent sleep experience, Nightfall redefines what performance bedding can be: effortless, restorative, and beautifully cool.\u003c\/p\u003e","published_at":"2025-10-24T00:13:11-04:00","created_at":"2025-10-23T12:36:05-04:00","updated_at":"2026-11-05T01:45:21-05:00","vendor":"SHEEX","product_type":"Sheet Sets","tags":["Cooling Sheet Sets","Moisture Wicking","nightfall","Performance Bedding","Queen","Sheet Sets","YGroup_nfsheetset","YGroup_Nightfall_bundle"],"variants":[{"id":49877341012106,"title":"Blue Mist \/ Twin\/TwinXL","option1":"Blue Mist","option2":"Twin\/TwinXL","option3":null,"sku":"210000-Nightfall-CoolingSheetSets-BlueMist-T\/TXL","requires_shipping":true,"taxable":true,"featured_image":{"id":42031998009482,"product_id":8709403902090,"position":38,"created_at":"2026-08-07T09:28:20-04:00","updated_at":"2026-08-07T09:28:22-04:00","alt":"Nightfall Sheet Sets shown in stack #choose-your-color_blue-mist","width":750,"height":750,"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-SheetSets-1.jpg?v=1786109302","variant_ids":[49877341012106,49877341044874,49877341077642,49877341110410,49877341143178]},"available":true,"price":"149.40","grams":2722,"compare_at_price":"249.00","position":1,"product_id":8709403902090,"created_at":"2026-08-07T09:31:23-04:00","updated_at":"2026-11-05T01: