ify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-SheetSets-1.jpg?v=1786109302","width":750,"height":750},{"id":42031997943946,"created_at":"2026-08-07T09:28:20-04:00","position":39,"updated_at":"2026-08-07T09:28:21-04:00","product_id":8709403902090,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-SheetSets-2.jpg?v=1786109301","width":750,"height":750},{"id":42031997976714,"created_at":"2026-08-07T09:28:20-04:00","position":40,"updated_at":"2026-08-07T09:28:22-04:00","product_id":8709403902090,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-SheetSets-3.jpg?v=1786109302","width":750,"height":750},{"id":42031998075018,"created_at":"2026-08-07T09:28:20-04:00","position":41,"updated_at":"2026-08-07T09:28:22-04:00","product_id":8709403902090,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-SheetSets-4.jpg?v=1786109302","width":750,"height":750},{"id":42031997878410,"created_at":"2026-08-07T09:28:20-04:00","position":42,"updated_at":"2026-08-07T09:28:22-04:00","product_id":8709403902090,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-SheetSets-7.jpg?v=1786109302","width":750,"height":750},{"id":42031997845642,"created_at":"2026-08-07T09:28:20-04:00","position":43,"updated_at":"2026-08-07T09:28:21-04:00","product_id":8709403902090,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-SheetSets-6.jpg?v=1786109301","width":750,"height":750},{"id":42031998042250,"created_at":"2026-08-07T09:28:20-04:00","position":44,"updated_at":"2026-08-07T09:28:21-04:00","product_id":8709403902090,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-SheetSets-5.jpg?v=1786109301","width":750,"height":750},{"id":42031997911178,"created_at":"2026-08-07T09:28:20-04:00","position":45,"updated_at":"2026-08-07T09:28:22-04:00","product_id":8709403902090,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-SheetSets-8.jpg?v=1786109302","width":750,"height":750}],"options":[{"name":"Choose Your Color","position":1,"values":["Blue Mist","Cloud White","Silver Dusk","Sand Dune","Black Eclipse"]},{"name":"Choose Your Size","position":2,"values":["Twin\/TwinXL","Full","Queen","King\/Cal King","Split King"]}]},{"id":8670028726410,"title":"Original Performance Ultimate Bedding Bundle","handle":"original-performance-ultimate-bedding-bundle","body_html":"\u003cp data-start=\"324\" data-end=\"883\"\u003eTransform your bedroom into a high-performance sleep sanctuary with the \u003cstrong data-start=\"396\" data-end=\"435\"\u003eSHEEX® Ultimate Sleep System Bundle\u003c\/strong\u003e — the most complete collection of SHEEX innovation in one seamless set. This deluxe bundle includes \u003cstrong data-start=\"536\" data-end=\"559\"\u003eeverything you need\u003c\/strong\u003e for a fully upgraded bed, from the cooling base layer to the ultra-cozy top layer: our \u003cstrong data-start=\"647\" data-end=\"681\"\u003eOriginal Performance Sheet Set\u003c\/strong\u003e, \u003cstrong data-start=\"683\" data-end=\"702\"\u003ePillowcase Pair\u003c\/strong\u003e, \u003cstrong data-start=\"704\" data-end=\"719\"\u003eDuvet Cover\u003c\/strong\u003e, \u003cstrong data-start=\"721\" data-end=\"745\"\u003eAll Season Comforter\u003c\/strong\u003e (in your choice of \u003cstrong data-start=\"765\" data-end=\"781\"\u003eBright White\u003c\/strong\u003e or \u003cstrong data-start=\"785\" data-end=\"797\"\u003eGraphite\u003c\/strong\u003e), \u003cstrong data-start=\"800\" data-end=\"821\"\u003etwo plush pillows\u003c\/strong\u003e, and our temperature-regulating \u003cstrong data-start=\"854\" data-end=\"882\"\u003ePerformance Mattress Pad\u003c\/strong\u003e.\u003c\/p\u003e\n\u003cp data-start=\"885\" data-end=\"1018\"\u003ePerfect for hot sleepers, athletes, or anyone serious about rest and recovery, this bundle takes sleep performance to the next level.\u003c\/p\u003e\n\u003ch3 data-start=\"1025\" data-end=\"1049\"\u003e\u003cstrong data-start=\"1029\" data-end=\"1049\"\u003eWhat’s Included:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003cul data-start=\"1050\" data-end=\"1433\"\u003e\n\u003cli data-start=\"1050\" data-end=\"1152\"\u003e\n\u003cp data-start=\"1052\" data-end=\"1152\"\u003e1 × \u003cstrong data-start=\"1056\" data-end=\"1090\"\u003eOriginal Performance Sheet Set\u003c\/strong\u003e\u003cbr data-start=\"1090\" data-end=\"1093\"\u003e(Includes fitted sheet, flat sheet, and 2 pillowcases)\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"1153\" data-end=\"1201\"\u003e\n\u003cp data-start=\"1155\" data-end=\"1201\"\u003e1 × \u003cstrong data-start=\"1159\" data-end=\"1199\"\u003eOriginal Performance Pillowcase Pair\u003c\/strong\u003e\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"1202\" data-end=\"1246\"\u003e\n\u003cp data-start=\"1204\" data-end=\"1246\"\u003e1 × \u003cstrong data-start=\"1208\" data-end=\"1244\"\u003eOriginal Performance Duvet Cover\u003c\/strong\u003e\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"1247\" data-end=\"1313\"\u003e\n\u003cp data-start=\"1249\" data-end=\"1313\"\u003e1 × \u003cstrong data-start=\"1253\" data-end=\"1284\"\u003eSHEEX® All Season Comforter\u003c\/strong\u003e (Bright White or Graphite)\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"1314\" data-end=\"1352\"\u003e\n\u003cp data-start=\"1316\" data-end=\"1352\"\u003e2 × \u003cstrong data-start=\"1320\" data-end=\"1350\"\u003eSHEEX® Performance Pillows\u003c\/strong\u003e\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"1353\" data-end=\"1433\"\u003e\n\u003cp data-start=\"1355\" data-end=\"1433\"\u003e1 × \u003cstrong data-start=\"1359\" data-end=\"1394\"\u003eSHEEX® Performance Mattress Pad\u003c\/strong\u003e\u003c\/p\u003e\n\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003e \u003c\/p\u003e\n\u003chr data-start=\"1435\" data-end=\"1438\"\u003e\n\u003ch3 data-start=\"1440\" data-end=\"1467\"\u003e\u003cstrong data-start=\"1444\" data-end=\"1467\"\u003eWhy You'll Love It:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003ch4 data-start=\"1469\" data-end=\"1506\"\u003e💨 \u003cstrong data-start=\"1477\" data-end=\"1506\"\u003eCooler Sleep, Every Layer\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp data-start=\"1507\" data-end=\"1705\"\u003eOur \u003cstrong data-start=\"1511\" data-end=\"1543\"\u003eOriginal Performance bedding\u003c\/strong\u003e is crafted with advanced moisture-wicking, breathable fabric that pulls heat and sweat away from your body to keep you cool, dry, and comfortable all night long.\u003c\/p\u003e\n\u003ch4 data-start=\"1707\" data-end=\"1750\"\u003e🛌 \u003cstrong data-start=\"1715\" data-end=\"1750\"\u003eComplete Comfort, Top to Bottom\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp data-start=\"1751\" data-end=\"1947\"\u003eFrom the \u003cstrong data-start=\"1760\" data-end=\"1799\"\u003etemperature-regulating mattress pad\u003c\/strong\u003e to the \u003cstrong data-start=\"1807\" data-end=\"1831\"\u003eall-season comforter\u003c\/strong\u003e, every element in this bundle is designed to work in harmony—keeping you cozy without overheating, 365 days a year.\u003c\/p\u003e\n\u003ch4 data-start=\"1949\" data-end=\"1980\"\u003e💤 \u003cstrong data-start=\"1957\" data-end=\"1980\"\u003eSupport That Adapts\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp data-start=\"1981\" data-end=\"2170\"\u003eOur \u003cstrong data-start=\"1985\" data-end=\"2008\"\u003ePerformance Pillows\u003c\/strong\u003e provide just the right blend of softness and support, contouring to your head and neck to relieve pressure and enhance alignment for deeper, uninterrupted sleep.\u003c\/p\u003e\n\u003ch4 data-start=\"2172\" data-end=\"2221\"\u003e🌙 \u003cstrong data-start=\"2180\" data-end=\"2221\"\u003ePerformance-Focused, Athlete-Inspired\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp data-start=\"2222\" data-end=\"2381\"\u003eOriginally developed by elite athletes, SHEEX® bedding combines technical innovation with luxurious softness—engineered to move with your body, not against it.\u003c\/p\u003e\n\u003ch4 data-start=\"2383\" data-end=\"2423\"\u003e🧺 \u003cstrong data-start=\"2391\" data-end=\"2423\"\u003eLow Maintenance, High Impact\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp data-start=\"2424\" data-end=\"2583\"\u003eAll items are \u003cstrong data-start=\"2438\" data-end=\"2459\"\u003ewrinkle-resistant\u003c\/strong\u003e, \u003cstrong data-start=\"2461\" data-end=\"2477\"\u003equick-drying\u003c\/strong\u003e, and \u003cstrong data-start=\"2483\" data-end=\"2503\"\u003emachine washable\u003c\/strong\u003e, making care effortless while maintaining long-lasting softness and durability.\u003c\/p\u003e\n\u003chr data-start=\"2585\" data-end=\"2588\"\u003e\n\u003ch3 data-start=\"2590\" data-end=\"2614\"\u003e\u003cstrong data-start=\"2594\" data-end=\"2614\"\u003eBundle Benefits:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003cul data-start=\"2615\" data-end=\"2896\"\u003e\n\u003cli data-start=\"2615\" data-end=\"2671\"\u003e\n\u003cp data-start=\"2617\" data-end=\"2671\"\u003eSave significantly with this complete bedding solution\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"2672\" data-end=\"2733\"\u003e\n\u003cp data-start=\"2674\" data-end=\"2733\"\u003eIdeal for hot sleepers, active lifestyles, and modern homes\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"2734\" data-end=\"2797\"\u003e\n\u003cp data-start=\"2736\" data-end=\"2797\"\u003eChoose your comforter color: \u003cstrong data-start=\"2765\" data-end=\"2781\"\u003eBright White\u003c\/strong\u003e or \u003cstrong data-start=\"2785\" data-end=\"2797\"\u003eGraphite\u003c\/strong\u003e\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"2798\" data-end=\"2844\"\u003e\n\u003cp data-start=\"2800\" data-end=\"2844\"\u003eStylish, coordinated look from top to bottom\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"2845\" data-end=\"2896\"\u003e\n\u003cp data-start=\"2847\" data-end=\"2896\"\u003eMakes an exceptional gift or full bedroom upgrade\u003c\/p\u003e\n\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003chr data-start=\"2898\" data-end=\"2901\"\u003e\n\u003ch3 data-start=\"2903\" data-end=\"2927\"\u003e\u003cstrong data-start=\"2907\" data-end=\"2927\"\u003eProduct Details:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003cul data-start=\"2928\" data-end=\"3432\"\u003e\n\u003cli data-start=\"2928\" data-end=\"3011\"\u003e\n\u003cp data-start=\"2930\" data-end=\"3011\"\u003e\u003cstrong data-start=\"2930\" data-end=\"2970\"\u003eFabric (Sheets, Duvet, Pillowcases):\u003c\/strong\u003e 87% Microfiber Polyester \/ 13% Spandex\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"3012\" data-end=\"3063\"\u003e\n\u003cp data-start=\"3014\" data-end=\"3063\"\u003e\u003cstrong data-start=\"3014\" data-end=\"3034\"\u003eComforter Shell:\u003c\/strong\u003e 100% Performance Polyester\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"3064\" data-end=\"3116\"\u003e\n\u003cp data-start=\"3066\" data-end=\"3116\"\u003e\u003cstrong data-start=\"3066\" data-end=\"3085\"\u003eComforter Fill:\u003c\/strong\u003e Lightweight down-alternative\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"3117\" data-end=\"3181\"\u003e\n\u003cp data-start=\"3119\" data-end=\"3181\"\u003e\u003cstrong data-start=\"3119\" data-end=\"3136\"\u003eMattress Pad:\u003c\/strong\u003e Quilted with breathable performance fabric\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"3182\" data-end=\"3254\"\u003e\n\u003cp data-start=\"3184\" data-end=\"3254\"\u003e\u003cstrong data-start=\"3184\" data-end=\"3196\"\u003ePillows:\u003c\/strong\u003e Hypoallergenic with adaptive fill for comfort \u0026amp; support\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"3255\" data-end=\"3312\"\u003e\n\u003cp data-start=\"3257\" data-end=\"3312\"\u003e\u003cstrong data-start=\"3257\" data-end=\"3271\"\u003eSheet Fit:\u003c\/strong\u003e Accommodates mattresses up to 18\" deep\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"3313\" data-end=\"3386\"\u003e\n\u003cp data-start=\"3315\" data-end=\"3386\"\u003e\u003cstrong data-start=\"3315\" data-end=\"3334\"\u003eCertifications:\u003c\/strong\u003e OEKO-TEX® certified for safety and sustainability\u003c\/p\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"3387\" data-end=\"3432\"\u003e\n\u003cp data-start=\"3389\" data-end=\"3432\"\u003e\u003cstrong data-start=\"3389\" data-end=\"3398\"\u003eCare:\u003c\/strong\u003e Machine wash cold, tumble dry low\u003c\/p\u003e\n\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003chr data-start=\"3434\" data-end=\"3437\"\u003e\n\u003ch2 data-start=\"3439\" data-end=\"3483\"\u003e\u003cstrong data-start=\"3442\" data-end=\"3481\"\u003eUpgrade to Total Performance Sleep.\u003c\/strong\u003e\u003c\/h2\u003e\n\u003cp data-start=\"3484\" data-end=\"3628\"\u003eOne bundle. Every layer. Infinite comfort.\u003cbr data-start=\"3526\" data-end=\"3529\"\u003eExperience the cooling, breathable, performance-enhanced sleep system that only SHEEX® can deliver.\u003c\/p\u003e","published_at":"2025-09-30T11:18:04-04:00","created_at":"2025-09-12T10:18:25-04:00","updated_at":"2026-11-05T01:45:21-05:00","vendor":"SHEEX","product_type":"","tags":["_exclude_stock_tag","Cooling Sheet Sets","Cooling Sheets","Moisture Wicking","Performance Bedding","pickystory","Queen","Sheet Sets","YGroup_op_sheets"],"variants":[{"id":47044965040266,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"1578.90","grams":0,"compare_at_price":"1662.00","position":1,"product_id":8670028726410,"created_at":"2025-09-12T10:18:25-04:00","updated_at":"2026-11-05