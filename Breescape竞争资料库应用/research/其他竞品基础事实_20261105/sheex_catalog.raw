available":true,"price":"148.20","grams":1200,"compare_at_price":"228.00","position":7,"product_id":9245616078986,"created_at":"2026-08-10T11:08:37-04:00","updated_at":"2026-11-05T01:45:21-05:00"},{"id":49899684036746,"title":"Black Eclipse \/ King\/Cal King","option1":"Black Eclipse","option2":"King\/Cal King","option3":null,"sku":"210007-Nightfall-SheetsBundle-Fitted and Pillowcases-Black Eclipse-K\/CK","requires_shipping":true,"taxable":true,"featured_image":{"id":42070129377418,"product_id":9245616078986,"position":11,"created_at":"2026-08-10T11:06:37-04:00","updated_at":"2026-08-10T11:06:38-04:00","alt":"Nightfall European Style Sheet Set SHEEX #choose-your-color_black-eclipse","width":750,"height":750,"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-StarterSet-BlackEclipse-1.jpg?v=1786374398","variant_ids":[49899683905674,49899684036746]},"available":true,"price":"161.20","grams":1600,"compare_at_price":"248.00","position":8,"product_id":9245616078986,"created_at":"2026-08-10T11:08:37-04:00","updated_at":"2026-11-05T01:45:21-05:00"}],"images":[{"id":42477936279690,"created_at":"2026-09-11T22:06:15-04:00","position":1,"updated_at":"2026-09-11T22:06:16-04:00","product_id":9245616078986,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-StarterSet-SilverDusk-1_4d95d7c0-1547-41a6-a086-072d1d05d409.jpg?v=1789178776","width":750,"height":750},{"id":42070129574026,"created_at":"2026-08-10T11:06:37-04:00","position":2,"updated_at":"2026-08-10T11:06:38-04:00","product_id":9245616078986,"variant_ids":[49899683807370,49899683938442],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-StarterSet-CloudWhite-1.jpg?v=1786374398","width":750,"height":750},{"id":42070129541258,"created_at":"2026-08-10T11:06:37-04:00","position":3,"updated_at":"2026-08-10T11:06:38-04:00","product_id":9245616078986,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-StarterSet-CloudWhite-2.jpg?v=1786374398","width":750,"height":750},{"id":42070129508490,"created_at":"2026-08-10T11:06:37-04:00","position":4,"updated_at":"2026-08-10T11:06:39-04:00","product_id":9245616078986,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-StarterSet-CloudWhite-3.jpg?v=1786374399","width":750,"height":750},{"id":42070129475722,"created_at":"2026-08-10T11:06:37-04:00","position":5,"updated_at":"2026-08-10T11:06:38-04:00","product_id":9245616078986,"variant_ids":[49899683840138,49899683971210],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-StarterSet-SilverDusk-1.jpg?v=1786374398","width":750,"height":750},{"id":42070129442954,"created_at":"2026-08-10T11:06:37-04:00","position":6,"updated_at":"2026-08-10T11:06:38-04:00","product_id":9245616078986,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-StarterSet-SilverDusk-2.jpg?v=1786374398","width":750,"height":750},{"id":42070129410186,"created_at":"2026-08-10T11:06:37-04:00","position":7,"updated_at":"2026-08-10T11:06:38-04:00","product_id":9245616078986,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-StarterSet-SilverDusk-3.jpg?v=1786374398","width":750,"height":750},{"id":42070129672330,"created_at":"2026-08-10T11:06:37-04:00","position":8,"updated_at":"2026-08-10T11:06:38-04:00","product_id":9245616078986,"variant_ids":[49899683872906,49899684003978],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-StarterSet-SandDune-1.jpg?v=1786374398","width":750,"height":750},{"id":42070129639562,"created_at":"2026-08-10T11:06:37-04:00","position":9,"updated_at":"2026-08-10T11:06:38-04:00","product_id":9245616078986,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-StarterSet-SandDune-2.jpg?v=1786374398","width":750,"height":750},{"id":42070129606794,"created_at":"2026-08-10T11:06:37-04:00","position":10,"updated_at":"2026-08-10T11:06:38-04:00","product_id":9245616078986,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-StarterSet-SandDune-3.jpg?v=1786374398","width":750,"height":750},{"id":42070129377418,"created_at":"2026-08-10T11:06:37-04:00","position":11,"updated_at":"2026-08-10T11:06:38-04:00","product_id":9245616078986,"variant_ids":[49899683905674,49899684036746],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-StarterSet-BlackEclipse-1.jpg?v=1786374398","width":750,"height":750},{"id":42070129737866,"created_at":"2026-08-10T11:06:37-04:00","position":12,"updated_at":"2026-08-10T11:06:39-04:00","product_id":9245616078986,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-StarterSet-BlackEclipse-2.jpg?v=1786374399","width":750,"height":750},{"id":42070129705098,"created_at":"2026-08-10T11:06:37-04:00","position":13,"updated_at":"2026-08-10T11:06:39-04:00","product_id":9245616078986,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/SHEEX_PDP_Nightfall-StarterSet-BlackEclipse-3.jpg?v=1786374399","width":750,"height":750}],"options":[{"name":"Choose Your Color","position":1,"values":["Cloud White","Silver Dusk","Sand Dune","Black Eclipse"]},{"name":"Choose Your Size","position":2,"values":["Queen","King\/Cal King"]}]},{"id":9099890524298,"title":"Supportive Pillow Bundle - 4 Pillows","handle":"supportive-pillow-bundle-4-pillows","body_html":"\u003cp\u003eBuild your perfect pillow bundle with the SHEEX® Mix \u0026amp; Match Cooling Pillow Bundle. Choose any FOUR pillows to create a sleep setup that works for you, your partner, or the way you move through the night.\u003c\/p\u003e\n\u003cp\u003eWhether you need adjustable comfort, side-sleeper support, cooling memory foam, down-alternative loft, or a calming scent-infused pillow experience, this bundle lets you personalize your rest without compromising on cooling comfort. Each SHEEX® pillow is designed with breathable materials, responsive support, and cooling technologies that help reduce heat buildup and promote a more comfortable night’s sleep.\u003c\/p\u003e\n\u003cp\u003eSelect two of your favorites, mix sleep styles if needed, and create a pillow pairing made for better sleep, cooler comfort, and personalized support.\u003c\/p\u003e","published_at":"2026-06-09T10:53:09-04:00","created_at":"2026-06-09T10:53:07-04:00","updated_at":"2026-11-05T01:45:21-05:00","vendor":"SHEEX","product_type":"Pillow","tags":["_exclude_stock_tag","Performance Bedding","pickystory","Pillows"],"variants":[{"id":49520826679434,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"198.00","grams":0,"compare_at_price":"396.00","position":1,"product_id":9099890524298,"created_at":"2026-06-09T10:53:07-04:00","updated_at":"2026-11-05T01:45:21-05:00"}],"images":[{"id":41343551864970,"created_at":"2026-06-09T10:55:00-04:00","position":1,"updated_at":"2026-07-20T14:37:36-04:00","product_id":9099890524298,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/story-idjuukxc91i-1781016895913.jpg?v=1784572656","width":750,"height":750}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9082931183754,"title":"Active Comfort Ultimate Bedding Bundle","handle":"active-comfort-ultimate-bedding-bundle","body_html":"\u003cp\u003eTransform your bedroom into a high-performance sleep sanctuary with the \u003cstrong data-start=\"396\" data-end=\"435\"\u003eSHEEX® Ultimate Sleep System Bundle\u003c\/strong\u003e — the most complete collection of SHEEX innovation in one seamless set. This deluxe bundle includes \u003cstrong data-start=\"536\" data-end=\"559\"\u003eeverything you need\u003c\/strong\u003e for a fully upgraded bed, from the cooling base layer to the ultra-cozy top layer: our \u003cstrong data-start=\"647\" data-end=\"681\"\u003eActive Comfort Sheet Set\u003c\/strong\u003e, \u003cstrong data-start=\"683\" data-end=\"702\"\u003ePillowcase Pair\u003c\/strong\u003e, Original Performance \u003cstrong data-start=\"704\" data-end=\"719\"\u003eDuvet Cover\u003c\/strong\u003e, \u003cstrong data-start=\"721\" data-end=\"745\"\u003eNightfall Cloud Comforter\u003c\/strong\u003e, \u003cstrong data-start=\"800\" data-end=\"821\"\u003efour plush pillows\u003c\/strong\u003e, and our temperature-regulating \u003cstrong data-start=\"854\" data-end=\"882\"\u003ePerformance Mattress Pad\u003c\/strong\u003e.\u003c\/p\u003e\n\u003cp\u003ePerfect for hot sleepers, athletes, or anyone serious about rest and recovery, this bundle takes sleep performance to the next level.\u003c\/p\u003e\n\u003ch3 data-start=\"1025\" data-end=\"1049\"\u003e\u003cstrong data-start=\"1029\" data-end=\"1049\"\u003eWhat’s Included:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003cul data-start=\"1050\" data-end=\"1433\"\u003e\n\u003cli data-start=\"1050\" data-end=\"1152\"\u003e1 × \u003cstrong data-start=\"1056\" data-end=\"1090\"\u003eActive Comfort Sheet Set\u003c\/strong\u003e\u003cbr data-start=\"1090\" data-end=\"1093\"\u003e(Includes fitted sheet, flat sheet, and 2 pillowcases)\u003c\/li\u003e\n\u003cli data-start=\"1153\" data-end=\"1201\"\u003e1 × \u003cstrong data-start=\"1159\" data-end=\"1199\"\u003eActive Comfort Pillowcase Pair\u003c\/strong\u003e\n\u003c\/li\u003e\n\u003cli\u003e1 × \u003cstrong data-start=\"1253\" data-end=\"1284\"\u003eSHEEX® Nightfall Cloud Comforter\u003c\/strong\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"1202\" data-end=\"1246\"\u003e1 × \u003cstrong data-start=\"1208\" data-end=\"1244\"\u003eOriginal Performance Duvet Cover\u003c\/strong\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"1314\" data-end=\"1352\"\u003e4 × \u003cstrong data-start=\"1320\" data-end=\"1350\"\u003eSHEEX® Performance Pillows\u003c\/strong\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"1353\" data-end=\"1433\"\u003e1 × \u003cstrong data-start=\"1359\" data-end=\"1394\"\u003eSHEEX® Performance Mattress Pad\u003cbr\u003e\u003cbr\u003e\u003c\/strong\u003e\n\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003chr data-start=\"1435\" data-end=\"1438\"\u003e\n\u003ch3 data-start=\"1440\" data-end=\"1467\"\u003e\u003cstrong data-start=\"1444\" data-end=\"1467\"\u003eWhy You'll Love It:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003ch4 data-start=\"1469\" data-end=\"1506\"\u003e💨 \u003cstrong data-start=\"1477\" data-end=\"1506\"\u003eCooler Sleep, Every Layer\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp\u003eOur \u003cstrong\u003eArctic Aire•MAX \u0026amp; \u003c\/strong\u003e\u003cstrong data-start=\"1511\" data-end=\"1543\"\u003eOriginal Performance bedding\u003c\/strong\u003e is crafted with advanced moisture-wicking, breathable fabric that pulls heat and sweat away from your body to keep you cool, dry, and comfortable all night long.\u003c\/p\u003e\n\u003ch4 data-start=\"1707\" data-end=\"1750\"\u003e🛌 \u003cstrong data-start=\"1715\" data-end=\"1750\"\u003eComplete Comfort, Top to Bottom\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp\u003eFrom the \u003cstrong data-start=\"1760\" data-end=\"1799\"\u003etemperature-regulating mattress pad\u003c\/strong\u003e to the \u003cstrong data-start=\"1807\" data-end=\"1831\"\u003eall-season comforter\u003c\/strong\u003e, every element in this bundle is designed to work in harmony—keeping you cozy without overheating, 365 days a year.\u003c\/p\u003e\n\u003ch4 data-start=\"1949\" data-end=\"1980\"\u003e💤 \u003cstrong data-start=\"1957\" data-end=\"1980\"\u003eSupport That Adapts\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp\u003eOur \u003cstrong data-start=\"1985\" data-end=\"2008\"\u003ePerformance Pillows\u003c\/strong\u003e provide just the right blend of softness and support, contouring to your head and neck to relieve pressure and enhance alignment for deeper, uninterrupted sleep.\u003c\/p\u003e\n\u003ch4 data-start=\"2172\" data-end=\"2221\"\u003e🌙 \u003cstrong data-start=\"2180\" data-end=\"2221\"\u003ePerformance-Focused, Athlete-Inspired\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp\u003eOriginally developed by elite athletes, SHEEX® bedding combines technical innovation with luxurious softness—engineered to move with your body, not against it.\u003c\/p\u003e\n\u003ch4 data-start=\"2383\" data-end=\"2423\"\u003e🧺 \u003cstrong data-start=\"2391\" data-end=\"2423\"\u003eLow Maintenance, High Impact\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp\u003eAll items are \u003cstrong data-start=\"2438\" data-end=\"2459\"\u003ewrinkle-resistant\u003c\/strong\u003e, \u003cstrong data-start=\"2461\" data-end=\"2477\"\u003equick-drying\u003c\/strong\u003e, and \u003cstrong data-start=\"2483\" data-end=\"2503\"\u003emachine washable\u003c\/strong\u003e, making care effortless while maintaining long-lasting softness and durability.\u003c\/p\u003e\n\u003chr data-start=\"2585\" data-end=\"2588\"\u003e\n\u003ch3 data-start=\"2590\" data-end=\"2614\"\u003e\u003cstrong data-start=\"2594\" data-end=\"2614\"\u003eBundle Benefits:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003cul data-start=\"2615\" data-end=\"2896\"\u003e\n\u003cli data-start=\"2615\" data-end=\"2671\"\u003eSave significantly with this complete bedding solution\u003c\/li\u003e\n\u003cli data-start=\"2672\" data-end=\"2733\"\u003eIdeal for hot sleepers, active lifestyles, and modern homes\u003c\/li\u003e\n\u003cli data-start=\"2798\" data-end=\"2844\"\u003eStylish, coordinated look from top to bottom\u003c\/li\u003e\n\u003cli data-start=\"2845\" data-end=\"2896\"\u003eMakes an exceptional gift or full bedroom upgrade\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003chr data-start=\"2898\" data-end=\"2901\"\u003e\n\u003ch3 data-start=\"2903\" data-end=\"2927\"\u003e\u003cstrong data-start=\"2907\" data-end=\"2927\"\u003eProduct Details:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003cul data-start=\"2928\" data-end=\"3432\"\u003e\n\u003cli data-start=\"2928\" data-end=\"3011\"\u003e\n\u003cstrong data-start=\"2930\" data-end=\"2970\"\u003eFabric (Sheets \u0026amp; Pillowcases):\u003c\/strong\u003e 88% performance polyester, 12% spandex\u003c\/li\u003e\n\u003cli data-start=\"2928\" data-end=\"3011\"\u003e\n\u003cstrong\u003eDuvet\u003c\/strong\u003e\u003cstrong data-start=\"3014\" data-end=\"3034\"\u003e\u003cstrong data-start=\"2930\" data-end=\"2970\"\u003e: \u003c\/strong\u003e\u003c\/strong\u003e87% Microfiber Polyester \/ 13% Spandex\u003c\/li\u003e\n\u003cli data-start=\"3012\" data-end=\"3063\"\u003e\n\u003cstrong data-start=\"3014\" data-end=\"3034\"\u003eComforter Shell:\u003c\/strong\u003e 90% Cooling Nylon\/10% Spandex\u003c\/li\u003e\n\u003cli data-start=\"3064\" data-end=\"3116\"\u003e\n\u003cstrong data-start=\"3066\" data-end=\"3085\"\u003eComforter Fill:\u003c\/strong\u003e Lightweight down-alternative\u003c\/li\u003e\n\u003cli data-start=\"3117\" data-end=\"3181\"\u003e\n\u003cstrong data-start=\"3119\" data-end=\"3136\"\u003eMattress Pad:\u003c\/strong\u003e Quilted with breathable performance fabric\u003c\/li\u003e\n\u003cli data-start=\"3182\" data-end=\"3254\"\u003e\n\u003cstrong data-start=\"3184\" data-end=\"3196\"\u003ePillows:\u003c\/strong\u003e Hypoallergenic with adaptive fill for comfort \u0026amp; support\u003c\/li\u003e\n\u003cli data-start=\"3255\" data-end=\"3312\"\u003e\n\u003cstrong data-start=\"3257\" data-end=\"3271\"\u003eSheet Fit:\u003c\/strong\u003e Accommodates mattresses up to 18\" deep\u003c\/li\u003e\n\u003cli data-start=\"3313\" data-end=\"3386\"\u003e\n\u003cstrong data-start=\"3315\" data-end=\"3334\"\u003eCertifications:\u003c\/strong\u003e OEKO-TEX® certified for safety and sustainability\u003c\/li\u003e\n\u003cli data-start=\"3387\" data-end=\"3432\"\u003e\n\u003cstrong data-start=\"3389\" data-end=\"3398\"\u003eCare:\u003c\/strong\u003e Machine wash cold, tumble dry low\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003chr data-start=\"3434\" data-end=\"3437\"\u003e\n\u003cp data-start=\"3439\" data-end=\"3483\"\u003e\u003cstrong data-start=\"3442\" data-end=\"3481\"\u003eUpgrade to Total Performance Sleep.\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp\u003eOne bundle. Every layer. Infinite comfort.\u003cbr data-start=\"3526\" data-end=\"3529\"\u003eExperience the cooling, breathable, performance-enhanced sleep system that only SHEEX® can deliver.\u003c\/p\u003e","published_at":"2026-06-02T11:49:08-04:00","created_at":"2026-06-02T11:49:07-04:00","updated_at":"2026-11-05T01:45:21-05:00","vendor":"SHEEX","product_type":"","tags":["_exclude_stock_tag","breathable","Cooling Sheet Sets","Moisture Wicking","night sweats","Performance Bedding","Queen","Sheet Sets","temperature regulating"],"variants":[{"id":49487644688522,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"919.95","grams":0,"compare_at_price":"1062.00","position":1,"product_id":9082931183754,"created_at":"2026-06-02T11:49:07-04:00","updated_at":"2026-11-05T01:45:21-05:00"}],"images":[{"id":41282965799050,"created_at":"2026-06-02T11:49:07-04:00","position":1,"updated_at":"2026-06-02T11:49:09-04:00","product_id":9082931183754,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0073\/6061\/0375\/files\/story-idjuukxc91i-1780415046111.jpg?v=1780415349","width":750,"height":750}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9082904051850,"title":"Nightfall Ultimate Bedding Bundle","handle":"nightfall-ultimate-bedding-bundle","body_html":"\u003cp\u003eTransform your bedroom into a high-performance sleep sanctuary with the \u003cstrong data-start=\"396\" data-end=\"435\"\u003eSHEEX® Ultimate Sleep System Bundle\u003c\/strong\u003e — the most complete collection of SHEEX innovation in one seamless set. This deluxe bundle includes \u003cstrong data-start=\"536\" data-end=\"559\"\u003eeverything you need\u003c\/strong\u003e for a fully upgraded bed, from the cooling base layer to the ultra-cozy top layer: our \u003cstrong data-start=\"647\" data-end=\"681\"\u003eNightfall\u003c\/strong\u003e, \u003cstrong data-start=\"683\" data-end=\"702\"\u003ePillowcase Pair\u003c\/strong\u003e, Original Performance \u003cstrong data-start=\"704\" data-end=\"719\"\u003eDuvet Cover\u003c\/strong\u003e, \u003cstrong data-start=\"721\" data-end=\"745\"\u003eNightfall Cloud Comforter\u003c\/strong\u003e, \u003cstrong data-start=\"800\" data-end=\"821\"\u003efour plush pillows\u003c\/strong\u003e, and our temperature-regulating \u003cstrong data-start=\"854\" data-end=\"882\"\u003ePerformance Mattress Pad\u003c\/strong\u003e.\u003c\/p\u003e\n\u003cp\u003ePerfect for hot sleepers, athletes, or anyone serious about rest and recovery, this bundle takes sleep performance to the next level.\u003c\/p\u003e\n\u003ch3 data-start=\"1025\" data-end=\"1049\"\u003e\u003cstrong data-start=\"1029\" data-end=\"1049\"\u003eWhat’s Included:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003cul data-start=\"1050\" data-end=\"1433\"\u003e\n\u003cli data-start=\"1050\" data-end=\"1152\"\u003e1 × \u003cstrong data-start=\"1056\" data-end=\"1090\"\u003eNightfall Sheet Set\u003c\/strong\u003e\u003cbr data-start=\"1090\" data-end=\"1093\"\u003e(Includes fitted sheet, flat sheet, and 2 pillowcases)\u003c\/li\u003e\n\u003cli data-start=\"1153\" data-end=\"1201\"\u003e1 × \u003cstrong data-start=\"1159\" data-end=\"1199\"\u003eNightfall Pillowcase Pair\u003c\/strong\u003e\n\u003c\/li\u003e\n\u003cli\u003e1 × \u003cstrong data-start=\"1253\" data-end=\"1284\"\u003eSHEEX® Nightfall Cloud Comforter\u003c\/strong\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"1202\" data-end=\"1246\"\u003e1 × \u003cstrong data-start=\"1208\" data-end=\"1244\"\u003eOriginal Performance Duvet Cover\u003c\/strong\u003e\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"1314\" data-end=\"1352\"\u003e4 × \u003cstrong data-start=\"1320\" data-end=\"1350\"\u003eSHEEX® Performance Pillows\u003c\/strong\u003e\n\u003c\/li\u003e\n\u003cli data-start=\"1353\" data-end=\"1433\"\u003e1 × \u003cstrong data-start=\"1359\" data-end=\"1394\"\u003eSHEEX® Performance Mattress Pad\u003cbr\u003e\u003cbr\u003e\u003c\/strong\u003e\n\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003chr data-start=\"1435\" data-end=\"1438\"\u003e\n\u003ch3 data-start=\"1440\" data-end=\"1467\"\u003e\u003cstrong data-start=\"1444\" data-end=\"1467\"\u003eWhy You'll Love It:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003ch4 data-start=\"1469\" data-end=\"1506\"\u003e💨 \u003cstrong data-start=\"1477\" data-end=\"1506\"\u003eCooler Sleep, Every Layer\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp\u003eOur \u003cstrong\u003eArctic Aire•MAX \u0026amp; \u003c\/strong\u003e\u003cstrong data-start=\"1511\" data-end=\"1543\"\u003eOriginal Performance bedding\u003c\/strong\u003e is crafted with advanced moisture-wicking, breathable fabric that pulls heat and sweat away from your body to keep you cool, dry, and comfortable all night long.\u003c\/p\u003e\n\u003ch4 data-start=\"1707\" data-end=\"1750\"\u003e🛌 \u003cstrong data-start=\"1715\" data-end=\"1750\"\u003eComplete Comfort, Top to Bottom\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp\u003eFrom the \u003cstrong data-start=\"1760\" data-end=\"1799\"\u003etemperature-regulating mattress pad\u003c\/strong\u003e to the \u003cstrong data-start=\"1807\" data-end=\"1831\"\u003eall-season comforter\u003c\/strong\u003e, every element in this bundle is designed to work in harmony—keeping you cozy without overheating, 365 days a year.\u003c\/p\u003e\n\u003ch4 data-start=\"1949\" data-end=\"1980\"\u003e💤 \u003cstrong data-start=\"1957\" data-end=\"1980\"\u003eSupport That Adapts\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp\u003eOur \u003cstrong data-start=\"1985\" data-end=\"2008\"\u003ePerformance Pillows\u003c\/strong\u003e provide just the right blend of softness and support, contouring to your head and neck to relieve pressure and enhance alignment for deeper, uninterrupted sleep.\u003c\/p\u003e\n\u003ch4 data-start=\"2172\" data-end=\"2221\"\u003e🌙 \u003cstrong data-start=\"2180\" data-end=\"2221\"\u003ePerformance-Focused, Athlete-Inspired\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp\u003eOriginally developed by elite athletes, SHEEX® bedding combines technical innovation with luxurious softness—engineered to move with your body, not against it.\u003c\/p\u003e\n\u003ch4 data-start=\"2383\" data-end=\"2423\"\u003e🧺 \u003cstrong data-start=\"2391\" data-end=\"2423\"\u003eLow Maintenance, High Impact\u003c\/strong\u003e\n\u003c\/h4\u003e\n\u003cp\u003eAll items are \u003cstrong data-start=\"2438\" data-end=\"2459\"\u003ewrinkle-resistant\u003c\/strong\u003e, \u003cstrong data-start=\"2461\" data-end=\"2477\"\u003equick-drying\u003c\/strong\u003e, and \u003cstrong data-start=\"2483\" data-end=\"2503\"\u003emachine washable\u003c\/strong\u003e, making care effortless while maintaining long-lasting softness and durability.\u003c\/p\u003e\n\u003chr data-start=\"2585\" data-end=\"2588\"\u003e\n\u003ch3 data-start=\"2590\" data-end=\"2614\"\u003e\u003cstrong data-start=\"2594\" data-end=\"2614\"\u003eBundle Benefits:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003cul data-start=\"2615\" data-end=\"2896\"\u003e\n\u003cli data-start=\"2615\" data-end=\"2671\"\u003eSave significantly with this complete bedding solution\u003c\/li\u003e\n\u003cli data-start=\"2672\" data-end=\"2733\"\u003eIdeal for hot sleepers, active lifestyles, and modern homes\u003c\/li\u003e\n\u003cli data-start=\"2798\" data-end=\"2844\"\u003eStylish, coordinated look from top to bottom\u003c\/li\u003e\n\u003cli data-start=\"2845\" data-end=\"2896\"\u003eMakes an exceptional gift or ful