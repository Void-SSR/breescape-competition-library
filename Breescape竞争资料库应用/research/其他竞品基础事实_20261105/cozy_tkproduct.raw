ShippingIcon}}":{"link_text_type":1,"icon_attribute":{"size":{"width":13,"height":13},"icon":{"icon":{"width":48,"height":48,"uri":"tos-maliva-i-o3syd03w52-us\u002Fpdp-lockup-free-shipping-light.png","url_list":["https:\u002F\u002Fp16-oec-general.ttcdn-us.com\u002Ftos-maliva-i-o3syd03w52-us\u002Fpdp-lockup-free-shipping-light.png~tplv-fhlh96nyum-resize-png:48:48.png?dr=12184&t=555f072d&ps=933b5bde&shp=c940a200&shcp=9b759fb9&idc=useast5&from=3376456192","https:\u002F\u002Fp19-oec-general.ttcdn-us.com\u002Ftos-maliva-i-o3syd03w52-us\u002Fpdp-lockup-free-shipping-light.png~tplv-fhlh96nyum-resize-png:48:48.png?dr=12184&t=555f072d&ps=933b5bde&shp=c940a200&shcp=9b759fb9&idc=useast5&from=3376456192"]}}}}},"text_attribute":{"link":"aweme:\u002F\u002Froma_redirect\u002F?spark_page=popupschema&title=Free%20shipping&ecrichtext_content=%5B%7B%22template%22:%22Enjoy%20free%20shipping%20on%20this%20purchase%21%20Shipping%20discounts%20are%20applied%20at%20checkout%20and%20are%20subject%20to%20conditions%20such%20as%20cart%20total%20or%20item%20count.%22%2C%22arguments%22:%7B%22%7B%7BTerms%7D%7D%22:%7B%22link_text_type%22:0%2C%22text_attribute%22:%7B%22text%22:%22%22%2C%22font%22:%7B%22font_weight%22:2%2C%22font_class%22:5%7D%7D%7D%7D%2C%22text_attribute%22:%7B%22font%22:%7B%22font_weight%22:1%2C%22font_class%22:4%7D%2C%22font_color%22:%7B%22color%22:%22%23FF000000%22%2C%22dark_color%22:%22%23FFF6F6F6%22%7D%7D%7D%5D&height=25%25&self_adaptive_height=1","font":{"font_weight":2,"font_class":4},"font_color":{"color":"#007B7B"}}}}],"compliance":{"title":"Seller information","contents":["Business name: Shanghai Sunwin Lohas Trading Co.,Ltd","Business address (This address has been automatically translated for your convenience):Shanghai,China"],"rich_title":{"template":"Seller information","text_attribute":{"font":{"font_weight":2,"font_class":4},"font_color":{"color":"#000000"}}},"rich_contents":[{"template":"Business name: Shanghai Sunwin Lohas Trading Co.,Ltd","text_attribute":{"font":{"font_weight":1,"font_class":4},"font_color":{"color":"#000000"}}},{"template":"Business address (This address has been automatically translated for your convenience):Shanghai,China","text_attribute":{"font":{"font_weight":1,"font_class":4},"font_color":{"color":"#000000"}}}]},"legit_warnings":[],"button_area_id":"default","page_sections":["head_image","top_margin","lock_up","lock_up_bottom_divider","sku_selection_v2_group","first_screen_divider","coupons_and_promotions","coupons_and_promotions_bottom_divider","multi_product_addon_group","logistic","creator_video","creator_video_bottom_divider","seller_above_review","shop_recommend_above_review","shop_recommend_above_review_bottom_divider","review","review_bottom_divider","description_title","about_this_product_description","about_this_product_details_top_line","about_this_product_details","about_this_product_compliance_top_line","about_this_product_compliance","about_this_product_compliance_bottom_divider"]},"aigc_info":{"long_text":"Cozy Bliss Heated Blanket Throw is a corded electric throw designed to bring fast, even warmth to your couch or bed. It uses advanced heating technology to help deliver consistent comfort with no cold spots, and it includes dual-zone heating so you and a partner can choose different preferred warmth settings. \n\nCustomize your comfort with 8 heat levels (90°F–125°F) and 8 timer settings (1–8 hours). For convenience, the memory function remembers your last settings, making it easy to return to your preferred warmth. For additional peace of mind, the heated throw features built-in overheat protection and an adjustable auto shut-off.\n\nWrapped in luxurious 630 GSM bubble faux fur with a silky-soft 230 GSM milk velvet reverse side, this cozy cream white throw (50\"x60\") is made for everyday relaxation. When it’s time to refresh, detach the controller and machine wash cold, then tumble dry low; do not iron. ETL Listed and FCC Compliant.","faq":"Q:What type of blanket is Cozy Bliss Heated Blanket Throw?\nA:It is a bubble faux fur electric heated blanket throw with a controller.\n\nQ:How big is the heated blanket throw and what color is it?\nA:The size is 50\"x60\" and the color is Cream White.\n\nQ:What heating controls does it offer?\nA:It provides 8 heat levels (90°F–125°F) and 8 timer settings (1–8 hours), and it includes a memory function that remembers your last settings.\n\nQ:What safety features are included?\nA:It features built-in overheat protection and an adjustable 1–8 hour auto shut-off, and it is ETL Listed and FCC Compliant.\n\nQ:What materials are used on each side of the throw?\nA:One side is 630 GSM bubble faux fur, and the reverse side is silky-soft 230 GSM milk velvet.\n\nQ:How do I wash the heated blanket throw?\nA:Detach the controller before washing. Machine wash cold and tumble dry low; do not iron.","bullet_points":"• Fast & even warmth with no cold spots plus dual-zone heating for personalized comfort\n• 8 heat levels (90°F–125°F) and 8 timer settings (1–8 hours) with memory function for easier repeat use\n• Auto shut-off and built-in overheat protection for added safety\n• Plush 630 GSM bubble faux fur with a silky-soft 230 GSM milk velvet reverse side\n• Machine washable care: detach the controller, machine wash cold, tumble dry low; do not iron","aigc_title":"Cozy Bliss Heated Blanket Throw, Bubble Faux Fur 50x60","aigc_description":"Cozy Bliss Heated Blanket Throw with bubble faux fur delivers fast, even warmth with 8 heat levels and 8 timer settings, auto shut-off & overheat protection.","aigc_keywords":[{"keyword":"Cozy Bliss heated blanket throw"},{"keyword":"heated electric blanket"},{"keyword":"bubble faux fur throw blanket"},{"keyword":"dual-zone heated blanket"},{"keyword":"8 heat levels 8 timer settings"},{"keyword":"auto shut-off overheat protection"},{"keyword":"ETL listed heated throw"},{"keyword":"machine washable heated blanket"}]},"review_info":{"has_more":false,"total_reviews":"1","product_reviews":[{"