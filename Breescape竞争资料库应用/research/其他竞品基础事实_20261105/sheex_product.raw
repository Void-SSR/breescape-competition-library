</div><div class="product-savings" data-savings-display>
        <span class="savings-text">
          Save 35% ($87.15 off)
        </span>
      </div></div><script>
    document.addEventListener('DOMContentLoaded', function() {
      const variantSelectors = document.querySelectorAll('[name="id"]');
      const savingsDisplay = document.querySelector('[data-savings-display]');
      
      if (!variantSelectors.length || !savingsDisplay) return;
      
      variantSelectors.forEach(selector => {
        selector.addEventListener('change', function() {
          const variantId = this.value;
          const variantData = window.product?.variants?.find(v => v.id == variantId);
          
          if (!variantData) return;
          
          if (variantData.compare_at_price && variantData.compare_at_price > variantData.price) {
            const savings = variantData.compare_at_price - variantData.price;
            const savingsPercentage = Math.round((savings / variantData.compare_at_price) * 100);
            const formattedSavings = new Intl.NumberFormat('en-US', {
              style: 'currency',
              currency: 'USD'
            }).format(savings / 100);
            
            savingsDisplay.innerHTML = `<span class="savings-text">Save ${savingsPercentage}% (${formattedSavings} off)</span>`;
            savingsDisplay.style.display = 'block';
          } else {
            savingsDisplay.style.display = 'none';
          }
        });
      });
    });
  </script><style>
    .product-savings {
      margin-top: 8px;
    }
    
    .savings-text {
      color: #d32f2f;
      font-weight: normal;
      font-size: 17px;
    }

    /* Color-tag media filtering (SHEEX) */
    .media-color-hidden {
      display: none !important;
    }
  </style>


