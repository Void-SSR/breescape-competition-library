<script>
  (function () {
    var sectionId = "template--23112337260682__trust_bar_gCePUW";
    var root = document.getElementById('sheex-tb-' + sectionId);
    if (!root) return;

    var displayFont = '"Larken", "Cormorant Garamond", Georgia, serif';
    var bodyFont = ' "DM Sans", ui-sans-serif, system-ui, sans-serif';

    function forceFonts() {
      root.querySelectorAll('.sheex-tb__top').forEach(function (el) {
        el.style.setProperty('font-family', displayFont, 'important');
      });
      root.querySelectorAll('.sheex-tb__bottom').forEach(function (el) {
        el.style.setProperty('font-family', bodyFont, 'important');
      });
    }

    forceFonts();

    var observer = new MutationObserver(function () {
      forceFonts();
    });

    root.querySelectorAll('.sheex-tb__top, .sheex-tb__bottom').forEach(function (el) {
      observer.observe(el, { attributes: true, attributeFilter: ['style'] });
    });

    window.addEventListener('load', forceFonts);
  })();
</script>


