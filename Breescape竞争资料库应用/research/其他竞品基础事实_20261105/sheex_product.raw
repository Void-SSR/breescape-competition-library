  <script>
		(function () {
			// Find the script element and check if we're in a quick view modal
			const scriptElement = document.currentScript;
			const isQuickView = scriptElement ? scriptElement.closest('quick-add-modal') : false;

			if ('true' == 'false' && isQuickView) {
				return;
			}

			const STORAGE_KEY = '__sf_theme_recently';
			const EXPIRATION_DAYS = 30;
			const productId = '1886637195335';
			const dateNow = Date.now();

			try {
				// Check if localStorage is available
				if (typeof Storage === 'undefined' || typeof localStorage === 'undefined') {
					return;
				}

				// Test localStorage access
				try {
					localStorage.setItem('__test__', '__test__');
					localStorage.removeItem('__test__');
				} catch (e) {
					return;
				}

				let recentProducts;
				try {
					const stored = localStorage.getItem(STORAGE_KEY);
					recentProducts = stored ? JSON.parse(stored) : [];
				} catch (error) {
					recentProducts = [];
				}

				const expirationTime = EXPIRATION_DAYS * 24 * 60 * 60 * 1000;
				recentProducts = recentProducts.filter((item) => dateNow - item.timestamp < expirationTime);

				const existingIndex = recentProducts.findIndex((item) => item.productId == productId);
				if (existingIndex !== -1) {
					recentProducts[existingIndex].timestamp = dateNow;
				} else {
					recentProducts.unshift({ productId: productId, timestamp: dateNow });
				}

				recentProducts.sort((a, b) => b.timestamp - a.timestamp);
				
				try {
					localStorage.setItem(STORAGE_KEY, JSON.stringify(recentProducts));
					// Dispatch custom event to notify recently-viewed section
					document.dispatchEvent(new CustomEvent('recentlyViewedUpdated'));
				} catch (setError) {
					if (setError.name === 'QuotaExceededError') {
						// localStorage quota exceeded - silently fail
					} else {
						throw setError;
					}
				}
			} catch (error) {
				// Handle any unexpected errors silently
				if (error.name !== 'SecurityError') {
					// Only log non-security errors in development if needed
				}
			}
		})();
	</script><script>
    (function () {
      const COLOR_OPTION_NAME = 'Choose Your Color';
      const root = document.currentScript
        ? (document.currentScript.closest('quick-add-modal') || document.currentScript.closest('section') || document.currentScript.closest('.product'))
        : document;
      const qsa = (selector) => (root || document).querySelectorAll(selector);

      // Store removed slides so we can restore them when color changes
      const removed = {
        main: [],
        thumbs: [],
        modal: []
      };

      function toHandle(str) {
        return (str || '')
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '');
      }

      function getSelectedColorHandle() {
        let radios = qsa(
          `input[type="radio"][name^="${COLOR_OPTION_NAME}-"], input[type="radio"][name*="${COLOR_OPTION_NAME}"]`
        );

        if (!radios.length) {
          radios = qsa(
            '#ProductInfo-template--23112337260682__main-product input[type="radio"], .product__info-container input[type="radio"]'
          );
        }

        for (const radio of radios) {
          if (radio.checked) {
            const name = (radio.name || '').toLowerCase();
            if (name.includes('color') || name.includes(COLOR_OPTION_NAME.toLowerCase().replace(/\s+/g, '-'))) {
              return toHandle(radio.value);
            }
          }
        }
        for (const radio of radios) {
          if (radio.checked) return toHandle(radio.value);
        }
        return '';
      }

      // Extract a clean color handle from an element
      function getColorTag(el) {
        // 1. Prefer the data attribute (already set by Liquid)
        let tag = (el.getAttribute('data-color-tag') || '').trim();
        if (tag) return tag;

        // 2. Fallback: parse the alt text (handles both _ and -)
        const img = el.querySelector('img');
        if (!img) return '';

        const alt = (img.getAttribute('alt') || '').toLowerCase();

        // Match #choose-your-color_xxx  OR  #choose-your-color-xxx
        let match = alt.match(/#choose-your[-_]color[-_]([a-z0-9-]+)/i);
        if (match) return toHandle(match[1]);

        // Also accept the broken format some Arctic images use: #choose-your-morning_ivory
        match = alt.match(/#choose-your[-_]([a-z0-9-]+)/i);
        if (match) return toHandle(match[1]);

        return ''; // truly shared image
      }

      function restoreAllSlides() {
        ['main', 'thumbs', 'modal'].forEach(key => {
          // Restore in original order
          removed[key]
            .sort((a, b) => a.originalIndex - b.originalIndex)
            .forEach(({ slide, wrapper }) => {
              if (wrapper && !wrapper.contains(slide)) {
                wrapper.appendChild(slide);
              }
            });
          removed[key] = [];
        });
      }

      function filterMediaByColor(colorHandle) {
        if (!colorHandle) return;

        // 1. Put every slide back
        restoreAllSlides();

        // 2. Decide visibility + set classes
        const mediaEls = qsa('.product__media-subitem, .product__media-item, .product-media-modal__item');
        let visibleMain = 0;
        mediaEls.forEach(el => {
          const tag = getColorTag(el);

          // Always write a clean data-color-tag for future runs
          if (tag) el.setAttribute('data-color-tag', tag);

          if (tag === '' || tag === colorHandle) {
            el.classList.remove('media-color-hidden');
            el.style.display = '';
            if (el.classList.contains('product__media-item')) visibleMain += 1;
          } else {
            el.classList.add('media-color-hidden');
          }
        });

        // A mismatched page color would hide every Quick View image. Keep the gallery.
        if (!visibleMain) {
          mediaEls.forEach(el => {
            el.classList.remove('media-color-hidden');
            el.style.display = '';
          });
          return;
        }

        // 3. Physically remove non-matching slides from the wrappers
        function removeFromWrapper(wrapperSelector, storageKey) {
          qsa(wrapperSelector).forEach(wrapper => {
            Array.from(wrapper.children).forEach((slide, index) => {
              if (slide.classList.contains('media-color-hidden')) {
                removed[storageKey].push({
                  slide,
                  wrapper,
                  originalIndex: index
                });
                slide.remove();
              }
            });
          });
        }

        removeFromWrapper('.js-media-list .swiper-wrapper, .product__media-list .swiper-wrapper', 'main');
        removeFromWrapper('.js-media-sublist .swiper-wrapper', 'thumbs');
        removeFromWrapper('.js-popup-slider .swiper-wrapper, .product-media-modal__content .swiper-wrapper', 'modal');

        // 4. Destroy existing Swipers
        ['.js-media-list.swiper', '.js-media-sublist.swiper', '.js-popup-slider.swiper'].forEach(sel => {
          qsa(sel).forEach(el => {
            if (el.swiper) {
              try { el.swiper.destroy(true, true); } catch (e) {}
            }
          });
        });

        // 5. Let the theme re-create the sliders with only the remaining slides
        setTimeout(() => {
          try {
            if (typeof subSliderInit === 'function') subSliderInit(true);
            if (typeof sliderInit === 'function') sliderInit(true);
            if (typeof popupSliderInit === 'function') popupSliderInit(true);
          } catch (e) {}

          // Force first slide
          setTimeout(() => {
            ['.js-media-list.swiper', '.js-media-sublist.swiper', '.js-popup-slider.swiper'].forEach(sel => {
              qsa(sel).forEach(el => {
                if (el.swiper) {
                  try {
                    el.swiper.slideTo(0, 0);
                    el.swiper.update();
                  } catch (e) {}
                }
              });
            });
          }, 60);
        }, 40);
      }

      function onColorChange() {
        const handle = getSelectedColorHandle();
        if (handle) filterMediaByColor(handle);
      }

      // Events
      root.addEventListener('change', e => {
        if (e.target?.matches?.('input[type="radio"]') &&
            (e.target.name || '').toLowerCase().includes('color')) {
          setTimeout(onColorChange, 100);
        }
      });

      root.addEventListener('click', e => {
        if (e.target.closest('label[for*="color"], .color-swatch, [data-option-name*="Color"], .product-form__input--swatch label, .product__color-swatch')) {
          setTimeout(onColorChange, 120);
        }
      });

      root.addEventListener('variant:change', () => setTimeout(onColorChange, 180));
      root.addEventListener('theme:variant:change', () => setTimeout(onColorChange, 180));

      // Initial load
      function init() {
        setTimeout(onColorChange, 500);
        setTimeout(onColorChange, 1400);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }

      document.addEventListener('shopify:section:load', () => setTimeout(onColorChange, 600));
    })();
  </script></section>


