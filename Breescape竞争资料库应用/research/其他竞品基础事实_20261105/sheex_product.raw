          logUtmParams(api._qzCache, t0 ? W.performance.now() - t0 : undefined);
        }
      }
      return api._qzCache;
    }

    var extraParams = [];
    function pushParam(key, value, override) {
      if (!key || value === null || value === undefined || value === '') return;
      extraParams.push([key, value, override !== false]);
    }pushParam('shopifyCountryCode', "US");pushParam('shopifyCountryCurrency', "$");var utmParams = getUtmParams();
    var utmOrigins = utmParams._origins;
    Object.keys(utmParams).forEach(function (key) {
      var fromUrl = !utmOrigins || utmOrigins[key] === 'url';
      pushParam(key, utmParams[key], fromUrl);
    });

    Array.prototype.forEach.call(frames, function (frame) {
      var baseUrl = frame.getAttribute('data-quizell-src');
      frame.removeAttribute('data-quizell-src');
      frame.src = extraParams.length ? withExtraParams(baseUrl) : baseUrl;
    });

    function withExtraParams(url) {
      var hashIndex = url.indexOf('#');
      var hash = hashIndex === -1 ? '' : url.slice(hashIndex);
      var withoutHash = hashIndex === -1 ? url : url.slice(0, hashIndex);

      var queryIndex = withoutHash.indexOf('?');
      var path = queryIndex === -1 ? withoutHash : withoutHash.slice(0, queryIndex);
      var search = new URLSearchParams(queryIndex === -1 ? '' : withoutHash.slice(queryIndex + 1));

      extraParams.forEach(function (param) {
        if (param[2] || !search.has(param[0])) search.set(param[0], param[1]);
      });

      var query = search.toString();
      return path + (query ? '?' + query : '') + hash;
    }
  })();
