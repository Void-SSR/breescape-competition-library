ustomer acquisition channel\",\"formId\":18809,\"fieldType\":\"SingleChoice\",\"value\":\" Referred by a friend\"},\"99298\":{\"title\":\"Quality\",\"formId\":18809,\"fieldType\":\"Rating\",\"value\":5},\"99297\":{\"title\":\"Functionality\",\"formId\":18809,\"fieldType\":\"Rating\",\"value\":5},\"99300\":{\"title\":\"Hair type\",\"formId\":18809,\"fieldType\":\"SingleChoice\",\"value\":\" Wavy\"},\"99299\":{\"title\":\"Purchase type\",\"formId\":18809,\"fieldType\":\"SingleChoice\",\"value\":\"No\"}},\"user\":{\"userId\":43882033,\"userType\":\"User\",\"isSocialConnected\":0,\"displayName\":\"Hope P.\"},\"country\":{\"code\":\"US\",\"label\":\"🇺🇸 United States\"},\"productVariants\":{\"Choose Your Size\":\"Queen\",\"Choose Your Color\":\"Bright White\"},\"language\":\"en\"},{\"id\":903043898,\"score\":5,\"votesUp\":0,\"votesDown\":0,\"content\":\"This is our second set of Sheex sheets. They are so delightfully comfortable to sleep on. And it is very easy to put them on the bed because they stretch in every direction.\",\"title\":\"Love these sheets!\",\"createdAt\":\"2026-10-08T22:29:31\",\"verifiedBuyer\":true,\"sentiment\":0.9648117,\"isIncentivized\":false,\"isShop\":false,\"customFields\":{\"99296\":{\"title\":\"Sleep habits\",\"formId\":18809,\"fieldType\":\"MultipleChoice\",\"value\":\"Partner\"},\"99295\":{\"title\":\"Sleep position\",\"formId\":18809,\"fieldType\":\"MultipleChoice\",\"value\":\"Back,  Side\"},\"99301\":{\"title\":\"Comfort\",\"formId\":18809,\"fieldType\":\"Rating\",\"value\":5},\"99298\":{\"title\":\"Quality\",\"formId\":18809,\"fieldType\":\"Rating\",\"value\":5},\"99297\":{\"title\":\"Functionality\",\"formId\":18809,\"fieldType\":\"Rating\",\"value\":5},\"99300\":{\"title\":\"Hair type\",\"formId\":18809,\"fieldType\":\"SingleChoice\",\"value\":\" Wavy\"},\"99299\":{\"title\":\"Purchase type\",\"formId\":18809,\"fieldType\":\"SingleChoice\",\"value\":\"No\"}},\"user\":{\"userId\":6632770,\"userType\":\"User\",\"isSocialConnected\":0,\"displayName\":\"Marilyn L.\"},\"country\":{\"code\":\"US\",\"label\":\"🇺🇸 United States\"},\"productVariants\":{\"Choose Your Size\":\"King\/Cal King\",\"Choose Your Color\":\"Bright White\"},\"language\":\"en\"},{\"id\":885474017,\"score\":5,\"votesUp\":1,\"votesDown\":0,\"content\":\"Wow first set of sheets ever to comepletly stay on my bed…. . top and bottom! Neither need to be tucked in of a morning and i DONT BURN UP @ night! Love the size of the top sheet because it is plenty big enough to go all the way down my 20” mattress! No more tug and pull with my husband trying to stay under the sheet 🙌🏼 hands down best set of sheets ever #1\",\"createdAt\":\"2026-08-30T21:29:59\",\"verifiedBuyer\":true,\"sentiment\":0.96712404,\"isIncentivized\":false,\"isShop\":true,\"topics\":{\"sheets\":{\"name\":\"sheets\",\"sentence\":\"Love the size of the top sheet because it is plenty big enough to go all the way down my 20” mattress!\"},\"tugging\":{\"name\":\"tugging\",\"sentence\":\"No more tug and pull with my husband trying to stay under the sheet :raised_hands::skin-tone-3: hands down best set of sheets ever #1\"}},\"user\":{\"userId\":88696114,\"userType\":\"User\",\"isSocialConnected\":0,\"displayName\":\"Tamara\"},\"productVariants\":{\"Choose Your Size\":\"King\/Cal King\",\"Choose Your Color\":\"Pearl Blue\"},\"language\":\"en\"},{\"id\":885138687,\"score\":1,\"votesUp\":0,\"votesDown\":1,\"content\":\"Bought these sheets because both the wife and I sleep hot so we were looking for sone cooler sheets. These are provably tge hottest sheets ive ever had. They literally made us both sweat profusely. I will say theyre comfortable as far as feel but they should be advertised as heating sheets.\",\"createdAt\":\"2026-08-28T20:12:25\",\"verifiedBuyer\":true,\"sentiment\":0.9152316,\"isIncentivized\":false,\"isShop\":true,\"topics\":{\"sheets\":{\"name\":\"sheets\",\"sentence\":\"These are provably tge hottest sheets ive ever had.\"}},\"user\":{\"userId\":298045450,\"userType\":\"User\",\"isSocialConnected\":0,\"displayName\":\"Colton\"},\"productVariants\":{\"Choose Your Size\":\"King\/Cal King\",\"Choose Your Color\":\"Graphite\"},\"language\":\"en\"},{\"id\":910109702,\"score\":5,\"votesUp\":0,\"votesDown\":0,\"content\":\"Best sheets ever! 15 plus years now.\",\"createdAt\":\"2026-10-22T19:25:38\",\"verifiedBuyer\":true,\"sentiment\":0.9835905,\"isIncentivized\":false,\"isShop\":true,\"topics\":{\"sheets\":{\"name\":\"sheets\",\"sentence\":\"Best sheets ever!\"}},\"user\":{\"userId\":343476760,\"userType\":\"User\",\"isSocialConnected\":0,\"displayName\":\"Derrick\"},\"language\":\"en\"},{\"id\":895116845,\"score\":5,\"votesUp\":0,\"votesDown\":0,\"content\":\"I love the color so beautiful. The sheets are soft and I have bought them before and they last a long time.\",\"createdAt\":\"2026-09-28T18:36:33\",\"verifiedBuyer\":true,\"sentiment\":0.976159,\"isIncentivized\":false,\"isShop\":true,\"topics\":{\"sheets\":{\"name\":\"sheets\",\"sentence\":\"The sheets are soft and I have bought them before and they last a long time.\"},\"color\":{\"name\":\"color\",\"sentence\":\"I love the color so beautiful.\"}},\"user\":{\"userId\":710410,\"userType\":\"User\",\"isSocialConnected\":0,\"displayName\":\"Deborah\"},\"language\":\"en\"}]}");
