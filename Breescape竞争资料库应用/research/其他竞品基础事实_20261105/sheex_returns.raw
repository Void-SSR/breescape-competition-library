  transition: none;
}
.picky-swatches__item [class*="_tooltip_"] {
  display: none;
}
/* Pills */
.picky-pill__item:hover:not([class*="_selected_"]):not([class*="_disabled_"]):before {
  right: 0;
  left: 0;
  border-color:
    color-mix(in srgb, var(--ps-theme-color) 10%, var(--ps-theme-background-color) 65%);
  opacity: 1;
}
.picky-pill__item[class*="_selected_"] {
  color: #000000;
  background: #FFFF;
}
.picky-pill__item[class*="_selected_"]:before {
  box-shadow: 0 0 0 2px #1c1d1d !important;
}
.picky-option__pill .picky-pill__item:before {
  border: none;
  box-shadow: 0 0 0 1px #e8e8e1;
  border-radius: 0;
}
.picky-option__wrapper .picky-option__pill {
  gap: 12px;
}
.picky-option__pill .picky-pill__item {
  font-family: "Avenir Next Regular", sans-serif;
  font-size: 13px;
}
/* Cart */
.picky-widget.picky-cart,
.picky-widget>[class*="_container_"][class*="_isVisible_"] {
  padding: 0;
  border-radius: 0;
  font-family: "Avenir Next Regular", sans-serif;
}
.picky-widget.picky-cart .picky-cart__content,
.picky-cart__footer .picky-cart__button:before,
.picky-product-preview .picky-button:before,
.picky-cart .picky-quantity,
.picky-cart .picky-quantity .picky-quantity__decrease-button,
.picky-cart .picky-quantity .picky-quantity__increase-button,
.picky-upsell-bundle [class*="_content_"],
.picky-byob-inline .picky-summary__header,
.picky-byob-inline .picky-summary__content {
  border-radius: 0;
}
.picky-cart__footer .picky-cart__button:hover:before,
.picky-product-preview .picky-button:hover:before {
  transform: none;
}
.picky-cart .picky-title {
  font-size: 16px;
  font-weight: 400;
}
.picky-cart .picky-quantity {
  font-size: 17px;
}
.picky-product-card__image:hover img {
  scale: none;
}
.picky-cart-item__title [class*="_inner_clickable_"]:hover {
  text-decoration: none;
}
.picky-quantity__increase-button:hover svg {
  scale: none;
}
.picky-cart .picky-quantity .picky-quantity__increase-button:hover,
.picky-cart .picky-quantity .picky-quantity__decrease-button:hover {
  background: #e8e8e1;
}
.picky-cart .picky-quantity .picky-quantity__increase-button:hover svg,
.picky-cart .picky-quantity .picky-quantity__decrease-button:hover svg {
  color: #FFFFFF;
}
.picky-cart .picky-sxgy:before {
  background: #FFFFFF;
}

.picky-sxgy,
.picky-recommendations {
top: 0 !important;
}
.picky-product-card.picky-recommended-card {
--info-size: calc((var(--ps-font-size) * 8px) + (var(--ps-font-size) * 20px * var(--ps-theme-product-card-name-font-size-scale, 1)) * 2 + (var(--ps-font-size) * 12px));
}

.picky-product-card.picky-recommended-card .picky-title.picky-product-card__title [class*="_inner_"] {
display: -webkit-box !important;
-webkit-box-orient: vertical !important;
-webkit-line-clamp: 2 !important;
overflow: hidden !important;
text-overflow: ellipsis !important;
white-space: normal !important;
line-height: 1.1em !important;
}

/*Recommended products to the bottom off the cart*/

.picky-cart__scrolled-wrapper {
  display: flex;
  flex-direction: column;
}

.picky-recommendations {
  order: 1;
  position: sticky;
  bottom: 0px;
}

.drawer.animate.active {
display: none !important;
}
  </style>

<!-- END app snippet -->





