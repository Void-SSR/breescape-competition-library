		letter-spacing: 0;
		text-align: center;
		color: #475159;
	}

	.header--mega-redesign .header__inline-menu .header__menu-item {
		display: flex;
		align-items: center;
		align-self: stretch;
		height: 100%;
	}

	.header--mega-redesign .header__inline-menu .header__menu-item > span {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		white-space: nowrap;
		line-height: 1;
	}

	.header--mega-redesign .header__inline-menu .header__menu-item > span::after {
		content: attr(data-mmr-label);
		font-weight: 700;
		height: 0;
		line-height: 0;
		overflow: hidden;
		visibility: hidden;
		pointer-events: none;
		user-select: none;
		white-space: nowrap;
		text-decoration: none;
	}

	.header--mega-redesign .header__inline-menu .header__menu-item:hover,
	.header--mega-redesign .header__inline-menu .header__menu-item:hover span,
	.header--mega-redesign .header__inline-menu .header__menu-item:active,
