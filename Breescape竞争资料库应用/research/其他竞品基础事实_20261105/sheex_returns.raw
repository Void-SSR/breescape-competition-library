    <script>
      (function () {
        function updateCartBubble() {
          fetch('/cart.js')
            .then(function (res) { return res.json(); })
            .then(function (cart) {
              var cartLink = document.getElementById('cart-icon-bubble');
              if (!cartLink) return;

              var bubble = cartLink.querySelector('.cart-count-bubble');
              var count = cart.item_count;
              var displayCount = count < 100 ? String(count) : '99+';

              if (count > 0) {
                if (!bubble) {
                  bubble = document.createElement('div');
                  bubble.className = 'cart-count-bubble';
                  bubble.innerHTML =
                    '<span aria-hidden="true"></span><span class="visually-hidden"></span>';
                  cartLink.appendChild(bubble);
                }
                bubble.querySelector('span[aria-hidden="true"]').textContent = displayCount;
                bubble.querySelector('span.visually-hidden').textContent =
                  count + (count === 1 ? ' item' : ' items');
                bubble.style.display = '';
              } else if (bubble) {
                bubble.remove();
              }
            })
            .catch(function (err) {
              console.error('Cart bubble update failed:', err);
            });
        }

        // Covers our own theme-native event and the ones fix-product.liquid dispatches.
        document.documentElement.addEventListener('cart:refresh', updateCartBubble);
        document.addEventListener('cart:updated', updateCartBubble);
        window.addEventListener('cart:updated', updateCartBubble);

        // Catch-all: watch every request that mutates the cart, no matter which
        // script or app fired it (theme, PickyStory, other apps' drawers, etc).
        // Several apps on this site already wrap window.fetch, so this wrapper
        // sits on top of whatever's there and still sees every call that
        // eventually reaches the network.
        var cartMutationPattern = /\/cart\/(add|change|update|clear)(\.js)?(\?|$)/;
        var originalFetch = window.fetch;
        window.fetch = function () {
          var request = arguments[0];
          var url = typeof request === 'string' ? request : (request && request.url) || '';

          var fetchPromise = originalFetch.apply(this, arguments);

          if (cartMutationPattern.test(url)) {
            fetchPromise.then(function () {
              // Slight delay so Shopify has fully committed the cart change
              // before we re-read it.
              setTimeout(updateCartBubble, 300);
            }).catch(function () {});
          }

          return fetchPromise;
        };

        // Some apps use XMLHttpRequest instead of fetch (PickyStory's remove
        // button does) — catch those too.
        var originalXhrOpen = XMLHttpRequest.prototype.open;
        XMLHttpRequest.prototype.open = function (method, url) {
          if (cartMutationPattern.test(url)) {
            this.addEventListener('loadend', function () {
              setTimeout(updateCartBubble, 300);
            });
          }
          return originalXhrOpen.apply(this, arguments);
        };
      })();
    </script>
