                        placeholder="Enter discount code" />
                 <button type="button"
                         tabindex="0"
                         class="limoniapps-discountninja-cartdiscountfield-apply">APPLY</button>
             </div><div class="limoniapps-discountninja-cartdiscountfield-discountcodes"></div><div style="display:none"
                  tabindex="0"
