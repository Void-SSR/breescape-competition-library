      customHtmlSlot: "\u003cstyle\u003e\nbody {overflow: visible !important;}\n\n.picky-cart__footer [class*=\"_integration_\"] {\npadding: 0 !important;\n}\n\u003c\/style\u003e\n\n\n\u003cscript\u003e\n(() =\u003e {\n  const CART = '.picky-widget.picky-cart';\n  const CART_LIST = `${CART} .picky-cart__scrolled-wrapper [class*=\"_list_\"]`;\n  const RECS_ROOT = '.picky-recommendations__content';\n  const BTN_SEL   = `${RECS_ROOT} \u003e [class*=\"_button_\"]`;\n  const STORAGE_OPENED = 'pickyRecsUserOpenedWhenNonEmpty_v3';\n\n  const loadOpenSet = () =\u003e { try { return new Set(JSON.parse(sessionStorage.getItem(STORAGE_OPENED) || '[]')); } catch { return new Set(); } };\n  const saveOpenSet = (s) =\u003e { try { sessionStorage.setItem(STORAGE_OPENED, JSON.stringify([...s])); } catch {} };\n  const USER_OPEN = loadOpenSet();\n\n  const isCartNonEmpty = () =\u003e !!document.querySelector(CART_LIST);\n  const recButtons = (scope = document) =\u003e [...scope.querySelectorAll(BTN_SEL)];\n  const isCollapsed = (btn) =\u003e \/_button_collapsed_\/i.test(btn.className);\n  const recKey = (btn) =\u003e {\n    const root = btn.closest(RECS_ROOT);\n    if (!root) return null;\n    const idAttr  = root.getAttribute('data-recs-id') || '';\n    const title   = (root.querySelector('[class*=\"_title_\"], .picky-title, h2, h3')?.textContent || '').trim();\n    return `recs:${idAttr || title || location.pathname}`;\n  };\n  const openIfCollapsed = (btn) =\u003e { if (isCollapsed(btn)) { btn.focus?.({preventScroll:true}); btn.click(); } };\n  const closeIfOpen     = (btn) =\u003e { if (!isCollapsed(btn)) { btn.focus?.({preventScroll:true}); btn.click(); } };\n\n  let lastWasEmpty = null;\n\n  function enforcePolicy(scope = document) {\n    const nowEmpty = !isCartNonEmpty();\n\n    if (lastWasEmpty === true \u0026\u0026 nowEmpty === false) {\n      USER_OPEN.clear(); saveOpenSet(USER_OPEN);\n      recButtons(scope).forEach(closeIfOpen);\n    } else {\n      if (nowEmpty) {\n        recButtons(scope).forEach(openIfCollapsed);\n      } else {\n        recButtons(scope).forEach((btn) =\u003e {\n          const key = recKey(btn);\n          if (!key) return;\n          if (!USER_OPEN.has(key)) closeIfOpen(btn);\n        });\n      }\n    }\n\n    lastWasEmpty = nowEmpty;\n  }\n\n  document.addEventListener('click', (e) =\u003e {\n    const btn = e.target.closest(BTN_SEL);\n    if (!btn) return;\n    setTimeout(() =\u003e {\n      if (!isCartNonEmpty()) return;\n      const key = recKey(btn);\n      if (!key) return;\n      if (!isCollapsed(btn)) {\n        if (!USER_OPEN.has(key)) { USER_OPEN.add(key); saveOpenSet(USER_OPEN); }\n      } else {\n        if (USER_OPEN.delete(key)) saveOpenSet(USER_OPEN);\n      }\n    }, 0);\n  }, true);\n\n  let burstId = null, burstUntil = 0;\n  function startBurst() {\n    const now = Date.now();\n    if (burstId) { burstUntil = now + 2500; return; }\n    burstUntil = now + 2500;\n    burstId = setInterval(() =\u003e {\n      enforcePolicy(document);\n      if (Date.now() \u003e burstUntil) { clearInterval(burstId); burstId = null; }\n    }, 120);\n  }\n\n  let mo = null;\n  function observeCart() {\n    if (mo) { try { mo.disconnect(); } catch {} mo = null; }\n    lastWasEmpty = !isCartNonEmpty();\n    startBurst();\n\n    const root = document.querySelector(CART);\n    if (!root) return;\n    mo = new MutationObserver((muts) =\u003e {\n      if (muts.some(m =\u003e m.type === 'childList' \u0026\u0026 (m.addedNodes.length || m.removedNodes.length))) {\n        startBurst();\n      }\n    });\n    mo.observe(root, { subtree: true, childList: true });\n  }\n\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', observeCart);\n  else observeCart();\n\n  document.addEventListener('click', (e) =\u003e {\n    if (e.target.closest('[data-action=\"open-cart\"], .open-cart, [href=\"#cart\"], [data-toggle=\"cart\"], [name=\"add\"], .add-to-cart, .picky-add-to-cart')) {\n      setTimeout(observeCart, 80);\n    }\n  });\n\n  window.addEventListener('picky:cart:open', observeCart);\n  window.addEventListener('picky:cart:updated', observeCart);\n\n  window.__recsReset = () =\u003e { USER_OPEN.clear(); saveOpenSet(USER_OPEN); observeCart(); };\n})();\n\u003c\/script\u003e",
