  async function initAlia() {
    const url = BACKEND_URL + "/public/launcher.js?shopifyUrl=sheex2008.myshopify.com";
    const script = document.createElement("script");
    script.src = url;
    script.async = true;
    document.head.appendChild(script);
  }
