<!-- BEGIN app snippet: quizell-iframe-params --><script>
  (function () {var W = window;

    var frames = document.querySelectorAll('iframe[data-quizell-src]');
    if (!frames.length) return;

    var UTM_RE = /(utm_[a-z0-9_]{2,30})["']?\s*[=:]\s*["']?([^"'&;,}#\n\r\t]{1,200})/gi;
    var HAS_UTM = /utm/i;          // cheap gate before the real regex

    var MAX_PARAMS  = 15;          // keep the iframe url sane
    var MAX_VALUE   = 200000;      // skip absurd single storage entries
    var MAX_KEYS    = 250;         // per storage area
    var SCAN_BUDGET = 600000;      // total chars of regex work we will do

    function collectUtmParams() {
      var found = {};
      var origins = {};
      var source = 'url';          // label for whatever is being scanned
      var count = 0;
      var budget = SCAN_BUDGET;

      // `decoded` marks values that arrived already url-decoded (URLSearchParams),
      // so we neither re-decode them nor turn a literal '+' into a space.
      function add(key, value, decoded) {
        if (count >= MAX_PARAMS) return;

        var name = String(key)
          .trim()
          .replace(/([a-z0-9])([A-Z])/g, '$1_$2')   // utmSource -> utm_Source
          .toLowerCase()
          .replace(/-/g, '_');

        if (!/^utm_[a-z0-9_]+$/.test(name)) return;
        if (Object.prototype.hasOwnProperty.call(found, name)) return;

        var val = String(value == null ? '' : value);
        if (!decoded) val = val.replace(/\+/g, ' ');
        val = val.trim().replace(/^["']|["']$/g, '');
        if (!val || /^(null|undefined)$/i.test(val)) return;

        if (!decoded && val.indexOf('%') !== -1) {
          try { val = decodeURIComponent(val); } catch (e) { /* leave raw */ }
        }

        found[name] = val.slice(0, 200);
        origins[name] = source;
        count++;
      }

      function match(text) {
        var hit = false;
        var m;
        UTM_RE.lastIndex = 0;
        while ((m = UTM_RE.exec(text)) !== null) {
          hit = true;
          add(m[1], m[2]);
          if (count >= MAX_PARAMS) break;
        }
        return hit;
      }

      function scan(str) {
        if (!str || count >= MAX_PARAMS || budget <= 0) return;

        var raw = typeof str === 'string' ? str : String(str);
        if (raw.length > MAX_VALUE) return;

        budget -= raw.length;
        if (!HAS_UTM.test(raw)) return;

        if (match(raw)) return;
        if (raw.indexOf('%') !== -1) {
          var decoded = raw;
          try { decoded = decodeURIComponent(raw.replace(/\+/g, ' ')); } catch (e) { return; }
          match(decoded);
        }
      }

      function scanStorage(which) {
        var store, len;
        try {
          store = W[which];
          len = store.length;
        } catch (e) {
          return;
        }
        var prefix = which === 'sessionStorage' ? 'session:' : 'local:';
        var total = len > MAX_KEYS ? MAX_KEYS : len;
        for (var i = 0; i < total; i++) {
          if (count >= MAX_PARAMS || budget <= 0) return;
          var key, value;
          try {
            key = store.key(i);
            value = key ? store.getItem(key) : null;
          } catch (e) {
            continue;
          }
          if (!value) continue;
          source = prefix + key;
          if (key.length < 40 && HAS_UTM.test(key)) add(key.replace(/^_+/, ''), value);
          scan(value);
        }
      }

      // Prefer a real parser for the address bar; fall back to the regex.
      function scanUrl() {
        source = 'url';
        var search = W.location.search;
        if (search && search.length > 1) {
          var parsed = false;
          try {
            if (typeof W.URLSearchParams === 'function') {
              new W.URLSearchParams(search).forEach(function (value, key) {
                add(key, value, true);
              });
              parsed = true;
            }
          } catch (e) { /* fall through to regex */ }
          if (!parsed) scan(search);
        }
        scan(W.location.hash);
      }

      function scanReferrer() {
        source = 'referrer';
        try {
          var ref = document.referrer;
          if (ref && ref.indexOf(W.location.origin) === 0) scan(ref);
        } catch (e) { /* ignore */ }
