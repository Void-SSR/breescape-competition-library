<script>
  document.addEventListener("DOMContentLoaded", function () {
    const section = document.querySelector(".section-template--19208946417910__product_media_swiper_nNhmXW");
    if (!section) return;

    const swiperEl = section.querySelector(".swiper");
    if (!swiperEl) return;

    const slides = swiperEl.querySelectorAll(".swiper-slide");

    // 自动轮播配置
    let autoplayConfig = false;
    if (false) {
      autoplayConfig = {
        delay: 4,
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      };
    }

    const swiper = new Swiper(swiperEl, {
      spaceBetween: 16,
      loop: true,
      centeredSlides: true,
      slideToClickedSlide: true,
      speed: 500,
      grabCursor: true,
      initialSlide: Math.floor(slides.length / 2),

      autoplay: autoplayConfig,

      navigation: {
        nextEl: ".pms-template--19208946417910__product_media_swiper_nNhmXW-next",
        prevEl: ".pms-template--19208946417910__product_media_swiper_nNhmXW-prev",
      },

      breakpoints: {
        0: {
          slidesPerView: 1.7
        },
        769: {
          slidesPerView: 4.5
        }
      },

      on: {
        init() {
          setTimeout(() => handleMedia(this), 300);
        },
        slideChangeTransitionEnd() {
          handleMedia(this);
        }
      }
    });

    // 控制视频、Youtube播放
    function handleMedia(swiper) {
      swiper.slides.forEach((slide) => {
        const isActive = slide.classList.contains("swiper-slide-active");

        const video = slide.querySelector("video");
        const cover = slide.querySelector(".video-cover");

        if (video) {
          if (isActive) {
            video.play().catch(err => {
              console.log(err);
            });
          } else {
            video.pause();
            if (cover) {
              cover.classList.remove("hide");
            }
          }
        }

        const iframe = slide.querySelector(".yt-player");
        if (iframe) {
          const command = isActive ? "playVideo" : "pauseVideo";
          setTimeout(() => {
            iframe.contentWindow.postMessage(
              JSON.stringify({
                event: "command",
                func: command,
                args: []
              }),
              "*"
            );
          }, 100);
        }
      });
    }

    // 视频真正开始播放后隐藏封面
    section.querySelectorAll(".img-box").forEach((box) => {
      const video = box.querySelector("video");
      const cover = box.querySelector(".video-cover");

      if (!video || !cover) return;

      video.addEventListener("playing", () => {
        cover.classList.add("hide");
      });

      video.addEventListener("pause", () => {
        cover.classList.remove("hide");
      });

      video.addEventListener("ended", () => {
        cover.classList.remove("hide");
      });
    });

    // 静音按钮
    const muteButtons = section.querySelectorAll(".mps-mute-btn");
    muteButtons.forEach((btn) => {
      btn.addEventListener("click", function (e) {
        e.stopPropagation();

        const video = this.closest(".img-box")?.querySelector("video");
        if (!video) return;

        video.muted = !video.muted;

        const mutedIcon = this.querySelector(".mps-mute-btn__icon--muted");
        const unmutedIcon = this.querySelector(".mps-mute-btn__icon--unmuted");

        if (video.muted) {
          mutedIcon.style.display = "flex";
          unmutedIcon.style.display = "none";
        } else {
          mutedIcon.style.display = "none";
          unmutedIcon.style.display = "flex";
        }
      });
    });
  });
</script>


