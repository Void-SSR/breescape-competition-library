<script>
  document.addEventListener('DOMContentLoaded', function () {
    const container = document.querySelector('#FabricSelector-template--19208946417910__collection_type_introduction_gqzGzP');
    if (!container) return;

    const swiperEl = container.querySelector('.fabric-swiper');
    const wrapperEl = swiperEl.querySelector('.swiper-wrapper');
    const buttons = container.querySelectorAll('.fabric-tab-btn');

    const allSlides = Array.from(container.querySelectorAll('.fabric-card'));

    let swiper = null;

    function renderSlides(targetCategory) {
      if (swiper) {
        swiper.destroy(true, true);
      }

      wrapperEl.innerHTML = '';

      allSlides.forEach((slide) => {
        if (slide.dataset.category === targetCategory) {
          const clonedSlide = slide.cloneNode(true);
          clonedSlide.style.display = '';
          wrapperEl.appendChild(clonedSlide);
        }
      });

      swiper = new Swiper(swiperEl, {
        slidesPerView: 2.2,
        spaceBetween: 16,
        navigation: {
          nextEl: container.querySelector('.fabric-button-next'),
          prevEl: container.querySelector('.fabric-button-prev'),
        },
        breakpoints: {
          750: {
            slidesPerView: 2.2,
            spaceBetween: 20,
          },
          1000: {
            slidesPerView: 3,
            spaceBetween: 24,
          },
        },
      });
    }

    renderSlides('Blanket');

    buttons.forEach((btn) => {
      btn.addEventListener('click', function () {
        if (this.classList.contains('active')) return;

        const target = this.dataset.target;

        buttons.forEach((b) => b.classList.remove('active'));
        this.classList.add('active');

        renderSlides(target);
      });
    });
  });
</script>


