<script>
  (() => {
    if (!window.collectionProductTwoRowController) {
      const instances = new WeakMap();
      const selector = '[data-collection-two-row-carousel]';

      function roots(scope) {
        return scope.matches?.(selector) ? [scope] : scope.querySelectorAll(selector);
      }

      function init(scope = document) {
        roots(scope).forEach((section) => {
          if (instances.has(section)) return;
          const controller = new AbortController();
          const signal = controller.signal;
          const tabTitles = section.querySelectorAll('.products-slide-option_title');
          const grids = Array.from(section.querySelectorAll('.collection-swiper-list_grid'));
          const models = new Map(
            grids.map((grid) => {
              const wrapper = grid.querySelector('.product-content-Slide-container-item');
              return [
                grid,
                {
                  wrapper,
                  cards: wrapper
                    ? Array.from(
                        wrapper.querySelectorAll(
                          ':scope > .Product-Cards-Slide-container, :scope > .collection-mobile-page > .Product-Cards-Slide-container'
                        )
                      )
                    : [],
                  pages: wrapper
                    ? Array.from(wrapper.children).filter((child) => child.classList.contains('collection-mobile-page'))
                    : [],
                },
              ];
            })
          );
          const mobile = window.matchMedia('(max-width: 749px)');
          let swiper = null;
          let currentGrid = null;
          let paged = false;
          let tabTimer = null;

          function number(value, fallback) {
            const result = Number(value);
            return Number.isFinite(result) && result > 0 ? result : fallback;
          }

          function restoreCards(model) {
            if (!model?.wrapper || !model.pages.length) return;
            model.cards.forEach((card) => model.wrapper.appendChild(card));
            model.pages.forEach((page) => page.remove());
            model.pages = [];
          }

          function groupCards(model) {
            restoreCards(model);
            for (let index = 0; index < model.cards.length; index += 4) {
              const page = document.createElement('div');
              page.className = 'swiper-slide collection-mobile-page';
              model.wrapper.appendChild(page);
              model.cards.slice(index, index + 4).forEach((card) => page.appendChild(card));
              model.pages.push(page);
            }
          }

          function destroySwiper() {
            if (swiper && !swiper.destroyed) swiper.destroy(true, true);
            swiper = null;
            restoreCards(models.get(currentGrid));
            currentGrid = null;
            paged = false;
          }

          function syncLayout(reset = false) {
            if (!section.isConnected) return;
            const grid = grids.find((item) => !item.classList.contains('is-hidden'));
            if (!grid) return;
            const model = models.get(grid);
            const swiperEl = grid.querySelector('.products-Cards_Slide_swiper');
            if (!swiperEl || !model?.wrapper || typeof window.Swiper !== 'function') return;
            const usePages = section.dataset.mobileGrid === 'true' && mobile.matches;

            if (!swiper || swiper.destroyed || currentGrid !== grid || paged !== usePages) {
              const position =
                !reset && swiper && !swiper.destroyed && currentGrid === grid
                  ? swiper.activeIndex * (paged ? 4 : 1)
                  : 0;
              destroySwiper();
              currentGrid = grid;
              paged = usePages;
              if (usePages) groupCards(model);
              else restoreCards(model);

              const options = {
                slidesPerView: usePages ? 1 : 1.1,
                slidesPerGroup: 1,
                initialSlide: usePages ? Math.floor(position / 4) : position,
                spaceBetween: Number(section.dataset.spaceBetweenIphone ?? 12),
                navigation: {
                  nextEl: grid.querySelector('.coll-cards-button-next'),
                  prevEl: grid.querySelector('.coll-cards-button-prev'),
                },
                preventClicks: false,
                preventClicksPropagation: false,
                slideToClickedSlide: false,
                a11y: false,
                touchStartPreventDefault: false,
                observer: true,
                observeParents: true,
                watchOverflow: false,
              };
              if (!usePages) {
                options.breakpoints = {
                  320: {
                    slidesPerView: number(section.dataset.arrangeIphone, 1.3),
                    spaceBetween: Number(section.dataset.spaceBetweenIphone ?? 12),
                  },
                  375: {
                    slidesPerView: number(section.dataset.arrangeIphone, 1.3),
                    spaceBetween: Number(section.dataset.spaceBetweenIphone ?? 12),
                  },
                  750: {
                    slidesPerView: number(section.dataset.arrangeIpad, 2.3),
                    spaceBetween: Number(section.dataset.spaceBetweenIpad ?? 25),
                  },
                  1000: {
                    slidesPerView: number(section.dataset.arrangePc, 3.5),
                    spaceBetween: Number(section.dataset.spaceBetweenPc ?? 40),
                  },
                };
              }
              swiper = new window.Swiper(swiperEl, options);
            }

            swiper.update();
            swiper.navigation?.update();
            if (reset) swiper.slideTo(0, 0);
          }

          tabTitles.forEach((tab) => {
            tab.addEventListener(
              'click',
              () => {
                tabTitles.forEach((item) => item.classList.remove('products-slide-title__active'));
                tab.classList.add('products-slide-title__active');
                grids.forEach((grid) => {
                  grid.classList.toggle('is-hidden', grid.dataset.index !== tab.dataset.index);
                });
                window.clearTimeout(tabTimer);
                tabTimer = window.setTimeout(() => syncLayout(true), 50);
              },
              { signal }
            );
          });

          mobile.addEventListener('change', () => syncLayout(), { signal });
          window.addEventListener('load', () => syncLayout(), { once: true, signal });
          instances.set(section, {
            destroy() {
              controller.abort();
              window.clearTimeout(tabTimer);
              destroySwiper();
              instances.delete(section);
            },
          });
          syncLayout();
        });
      }

      function destroy(scope) {
        roots(scope).forEach((section) => instances.get(section)?.destroy());
      }

      window.collectionProductTwoRowController = { init, destroy };
      document.addEventListener('shopify:section:load', (event) => init(event.target));
      document.addEventListener('shopify:section:unload', (event) => destroy(event.target));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => window.collectionProductTwoRowController.init(), {
        once: true,
      });
    } else {
      window.collectionProductTwoRowController.init();
    }
  })();
</script>

