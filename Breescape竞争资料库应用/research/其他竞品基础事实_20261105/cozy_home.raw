  el.dataset.shopCurrency = "USD";
  el.dataset.shopPageType = "index";
  el.dataset.analyticsPageType = "index";
  el.dataset.shopLanguageIsoCode = "en"
  el.dataset.shopRootUrl = "/"

  
    el.dataset.productId = "";
    el.dataset.productSelectedOrFirstAvailableVariant = "";
  

  el.dataset.productHandle = "";

  

  el.style.setProperty("position", "relative", "important");
  el.style.setProperty("z-index", "9999999999", "important");
  el.style.setProperty("width", "0", "important");
  el.style.setProperty("height", "0", "important");
  el.style.setProperty("display", "block", "important");
  el.style.setProperty("visibility", "visible", "important");
  el.style.setProperty("opacity", "1", "important");

  el.appendChild(document.createTextNode("\u200B"));

  function mountRoot() {
