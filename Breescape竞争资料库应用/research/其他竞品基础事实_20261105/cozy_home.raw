(function () {
  const el = document.createElement("div");
  el.id = "shopify-aura-connect-ef3352f3e8fd";

  el.dataset.shop = "cozy-bliss-shop.myshopify.com";
  el.dataset.shopDomain = "cozy-bliss-shop.myshopify.com";
  el.dataset.shopId = "54899081404";
  el.dataset.shopName = "Cozy Bliss";
  el.dataset.shopLocale = "";
