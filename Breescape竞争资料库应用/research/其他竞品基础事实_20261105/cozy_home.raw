<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('.section-template--19208946417910__tabs_reviews_carousel_nrTqVJ');
    if (!section) return;

    const tabButtons = section.querySelectorAll('.reviews-tab-btn');
    const panes = section.querySelectorAll('.reviews-tab-pane');
    const prevArrow = section.querySelector('.carousel-arrow.prev');
    const nextArrow = section.querySelector('.carousel-arrow.next');

    let currentActivePane = section.querySelector('.reviews-tab-pane.is-active');
    let currentIndex = 0;

    function getCarouselData(pane) {
      const track = pane.querySelector('.carousel-track');
      const cards = pane.querySelectorAll('.review-card');
      if (cards.length === 0) return { totalSteps: 0, stepWidth: 0, maxIndex: 0 };

      const cardWidth = cards[0].getBoundingClientRect().width;
      const gap = parseFloat(window.getComputedStyle(track).gap) || 0;
      const viewportWidth = pane.querySelector('.carousel-viewport').getBoundingClientRect().width;

      const visibleCards = Math.round(viewportWidth / (cardWidth + gap)) || 1;
      const maxIndex = Math.max(0, cards.length - visibleCards);

      return {
        track,
        maxIndex,
        stepWidth: cardWidth + gap,
      };
    }

    function updateCarouselPosition() {
      const { track, maxIndex, stepWidth } = getCarouselData(currentActivePane);
      if (!track) return;

      if (currentIndex > maxIndex) currentIndex = maxIndex;
      if (currentIndex < 0) currentIndex = 0;

      const translateX = -(currentIndex * stepWidth);
      track.style.transform = `translateX(${translateX}px)`;

      if (currentIndex === 0) prevArrow.classList.add('is-hidden');
      else prevArrow.classList.remove('is-hidden');

      if (currentIndex >= maxIndex) nextArrow.classList.add('is-hidden');
      else nextArrow.classList.remove('is-hidden');
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', function () {
        tabButtons.forEach((b) => b.classList.remove('is-active'));
        panes.forEach((p) => p.classList.remove('is-active'));

        this.classList.add('is-active');
        const targetId = this.getAttribute('data-tab-target');
        currentActivePane = section.querySelector(`#pane-${targetId}`);

        if (currentActivePane) {
          currentActivePane.classList.add('is-active');
          currentIndex = 0;
          updateCarouselPosition();
        }
      });
    });

    prevArrow.addEventListener('click', () => {
      if (currentIndex > 0) {
        currentIndex--;
        updateCarouselPosition();
      }
    });

    nextArrow.addEventListener('click', () => {
      const { maxIndex } = getCarouselData(currentActivePane);
      if (currentIndex < maxIndex) {
        currentIndex++;
        updateCarouselPosition();
      }
    });

    setTimeout(updateCarouselPosition, 100);

    window.addEventListener('resize', () => {
      updateCarouselPosition();
    });

    document.addEventListener('shopify:section:load', () => {
      updateCarouselPosition();
    });
  });
</script>


