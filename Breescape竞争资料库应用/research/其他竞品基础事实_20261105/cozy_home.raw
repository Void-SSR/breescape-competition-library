    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 40px;
  }

  .reviews-tab-btn {
    background-color: transparent;
    border: 1px solid #e2dfda;
    color: #2b1b4d;
    padding: 10px 24px;
    border-radius: 30px;
    font-size: 15px;
    cursor: pointer;
    transition: all 0.3s ease;
    outline: none;
  }

  .reviews-tab-btn.is-active {
    background-color: #877154;
    border-color: #877154;
    color: #ffffff;
  }

  .reviews-panes-wrapper {
    position: relative;
    width: 100%;
  }

  .reviews-tab-pane {
    display: none;
    position: relative;
    width: 100%;
  }

  .reviews-tab-pane.is-active {
    display: block;
  }

  .carousel-viewport {
    overflow: hidden;
    width: 100%;
    margin: 0 auto;
    padding: 10px 0;
  }

  .carousel-track {
    display: flex;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    gap: 20px;
    width: 100%;
  }

  .review-card {
    flex: 0 0 calc((100% - (20px * (var(--items-per-row-mobile) - 1))) / var(--items-per-row-mobile));
    background: #ffffff;
    border-radius: 16px;
    padding: 24px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    position: relative;
  }

  .review-card:has(.review-card-media) {
    display: flex;
    flex-direction: row;
    gap: 15px;
  }
  .review-card .review-card__links{
    position: absolute;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 767px) {
    .section-template--19208946417910__tabs_reviews_carousel_nrTqVJ[style*="--items-per-row-mobile: 1"] .review-card:has(.review-card-media) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }

  .review-card-media {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    overflow: hidden;
  }

  .review-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .review-card-info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
  }

  .review-stars {
    color: #877154;
    font-size: 16px;
    margin-bottom: 12px;
  }

  .review-text {
    font-size: 14px;
    line-height: 1.6;
    color: #2b1b4d;
    margin: 0 0 16px 0;
    font-weight: 500;
  }

  .review-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .review-author {
    font-size: 13px;
    font-weight: 600;
    color: #2b1b4d;
  }

  .review-date {
    font-size: 12px;
    color: #8a8a8a;
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid #e2dfda;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    color: #877154;
    transition: all 0.3s ease;
    outline: none;
  }

  .carousel-arrow:hover {
    background-color: #2b1b4d;
    color: #ffffff;
    border-color: #2b1b4d;
  }

  .carousel-arrow.prev { left: -20px; }
  .carousel-arrow.next { right: -20px; }
  .carousel-arrow.is-hidden { opacity: 0; pointer-events: none; }

  .carousel-arrow svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  @media (min-width: 768px) {
    .review-card {
      flex: 0 0 calc((100% - (20px * (var(--items-per-row-tablet) - 1))) / var(--items-per-row-tablet));
    }
    .carousel-arrow.prev { left: -25px; }
    .carousel-arrow.next { right: -25px; }
    .tabs-reviews-title{
      font-size:36px;
    }
    .review-text {
      font-size: 16px;
    }
  }

  @media (min-width: 992px) {
    .review-card {
      flex: 0 0 calc((100% - (20px * (var(--items-per-row-desktop) - 1))) / var(--items-per-row-desktop));
    }

    .section-template--19208946417910__tabs_reviews_carousel_nrTqVJ[style*="--items-per-row-desktop: 1"] .review-card:has(.review-card-media),
    .section-template--19208946417910__tabs_reviews_carousel_nrTqVJ[style*="--items-per-row-desktop: 2"] .review-card:has(.review-card-media),
    .section-template--19208946417910__tabs_reviews_carousel_nrTqVJ[style*="--items-per-row-desktop: 3"] .review-card:has(.review-card-media) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .section-template--19208946417910__tabs_reviews_carousel_nrTqVJ[style*="--items-per-row-desktop: 4"] .review-card,
    .section-template--19208946417910__tabs_reviews_carousel_nrTqVJ[style*="--items-per-row-desktop: 5"] .review-card,
    .section-template--19208946417910__tabs_reviews_carousel_nrTqVJ[style*="--items-per-row-desktop: 6"] .review-card,
    .section-template--19208946417910__tabs_reviews_carousel_nrTqVJ[style*="--items-per-row-desktop: 7"] .review-card,
    .section-template--19208946417910__tabs_reviews_carousel_nrTqVJ[style*="--items-per-row-desktop: 8"] .review-card,
    .section-template--19208946417910__tabs_reviews_carousel_nrTqVJ[style*="--items-per-row-desktop: 9"] .review-card,
    .section-template--19208946417910__tabs_reviews_carousel_nrTqVJ[style*="--items-per-row-desktop: 10"] .review-card {
      display: flex;
      flex-direction: column;
    }

    .carousel-viewport {
      padding: 15px 5px;
    }
    .carousel-arrow.prev { left: -30px; }
    .carousel-arrow.next { right: -30px; }
  }
</style>

